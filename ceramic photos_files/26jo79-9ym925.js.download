piration":{"recoverable":"Recoverable","recoverable_only_tooltip":"If you select \'Recoverable,\' WeTransfer %{plan} users can access the file even after it expires. Transfers will remain available for an extended period before being permanently deleted.","recoverable_tooltip":"Set an expiration date for your transfer. If you select \'Recoverable,\' WeTransfer %{plan} users can access the file even after it expires. Transfers will remain available for an extended period before being permanently deleted.","recoverable_transfer":"Recoverable transfer"},"filesystem_error":{"text":"One of your files seems to be causing an issue. Check if any file is corrupted and try again","title":"Invalid file in the transfer"},"firewall_blocked":{"text":"Your firewall or security software is blocking the transfer. Please make sure your network security settings comply with the <firewall_requirements_url>WeTransfer requirements</firewall_requirements_url>.","title":"Upload blocked by firewall"},"in_background":{"alert":"Leaving WeTransfer will interrupt your upload.","cta":"Upload in background"},"incomplete_upload":{"text":"The upload failed due to frequent interruptions in your connection. Please check your network and try again.","title":"Upload interrupted"},"network_error":{"text":"Network connection problem. Please check your internet connection and try again.","title":"Connection problem"},"no_files_uploaded":{"text":"It looks like none of your files finished uploading. Please try again.","title":"Your files didn\'t upload"},"server_error":{"text":"Server temporarily unavailable. Please try again in a few minutes.","title":"Server error"},"sharing_options":{"editing_enabled":"editing enabled","editors_count_one":"%{count} editor","editors_count_other":"%{count} editors","email_transfer_info":"For email transfers, the transfer\'s recipients are automatically authorized to view. Add here who should be authorized to add content instead.","label":"Sharing options","only_you_can_edi