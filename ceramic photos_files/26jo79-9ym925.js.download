 %{count} member","remove_selected_other":"Remove %{count} members","toast":{"added_one":"%{count} member added","added_other":"%{count} members added","removed_one":"%{count} member removed","removed_other":"%{count} members removed"},"view_members":"View members"},"members_callout":{"message":"Contact your workspace admin to set up your brand.","title":"Need to customize your branding?"},"save":"Save changes","save_error":"An error occurred while saving your changes","save_success":"Your changes have been saved successfully","selector":{"brand_hint":"This brand has its own link, title and wallpaper. Other branding settings stay at workspace level.","default_title":"Default brand","description":"Each brand has its own link, title and wallpaper. Every other setting stays at workspace level.","label":"Brand","main_brand_hint":"This is your workspace’s main brand: its link, title and wallpaper define the workspace branding. Sub-brands have their own link, title and wallpaper.","main_brand_label":"Main brand","new_cta":"New brand","title":"Your brands","unnamed_option":"New brand — %{title}","untitled_brand":"Untitled brand"},"title":"Branding","workspace":{"description":"Change the workspace name and icon.","input_label":"Workspace name","remove_icon_cta":"Remove icon","title":"Workspace","upload_icon_cta":"Upload new icon"}},"browser":{"assets_failed":{"text":"We couldn\'t load some important parts of our website.\\nThey may have been blocked by your firewall, proxy or browser set-up.\\nTry refreshing the page or get in touch through our <a href=\\"/help-center\\" rel=\\"external\\">help center</a>.","title":"Uh-oh..."},"javascript_needed":"You need a JavaScript-enabled browser to use WeTransfer"},"browser_notifications":{"modal":{"accept":"Yes, notify me","decline":"No, thanks","description":"Get notified when your uploads are complete, even when you\'re in another tab.","title":"Notify me when uploads are complete"},"notifications":{"upload_complete":"Your transfer