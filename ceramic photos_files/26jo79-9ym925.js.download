 Policy</refundPolicy> window, the payment will be refunded, and your account will be downgraded to the Free plan."},"error":{"disputed":"Your payment is disputed, and we cannot process a refund. Your subscription has been automatically canceled, and your payment processor will notify you of the refund outcome once the dispute is resolved. No further action is required on your part.","freeAccount":"This account is currently on a Free plan. To request a refund for your paid account, please log in to WeTransfer using the email address associated with your paid plan.","membersOrInvitesPresent":"Your team still has members or pending invitations. Please remove all members and cancel any pending invitations before requesting a refund, or contact support via <customerSupport>this form</customerSupport>.","noChargeFound":"We couldn\'t find any payment to refund. If you believe this is an error, please contact support via <customerSupport>this form</customerSupport>.","notYourTeam":"Only the owner of the team can request a refund. Please contact the owner of the team to proceed.","outsideOfRefundWindow":"Your request falls outside the <refundPolicy>refund policy</refundPolicy> window. You can check your last payment date in the <plansPage>Plan and payment</plansPage> page.","tierNotSupported":"Your subscription plan is not supported, please contact support via <customerSupport>this form</customerSupport> for more information.","tooManyRefunds":"We recently processed a refund for this account and we cannot proceed with your request - please contact support if you believe this is a mistake via <customerSupport>this form</customerSupport>.","unknown":"Something went wrong, please contact support via <customerSupport>this form</customerSupport> for more information.","unsupportedPaymentMethod":"Something went wrong, please contact support via <customerSupport>this form</customerSupport> for more information.","unsupportedProvider":"Your plan was purchased on the mobile Apps Store. To learn more on how to request a refund on those platform check <mobileRefund>this article.</mobileRefund>"},"go_home":"Go to homepage","price_increase_goodwill":"As a gesture of goodwill, we’re offering you a refund for your latest subscription payment as a consequence of the most recent price increase. Please note that the standard refund window is %{standardRefundWindowDays} days.","processing":"Processing...","submitted":"We’ve successfully submitted your refund request. A confirmation email will be sent, but please allow 5 to 10 days for the funds to be reimbursed.","title":"Self-service refund"},"request_form":{"error":{"annonymous_user_description":"Log in or sign up to request up to <strong>%{size_limit}</strong> transfers from anyone.","cta":{"communicate":"Yes, stay in touch","compare":"Compare plans","continue":"Continue to request","dismiss":"No thanks","log_in":"Log in","manage":"Manage requests","sign_up":"Sign up","tidy_up":"Tidy up transfers"},"limit_reached_description":"Please close some open requests or change your plan to keep receiving.","limit_reached_title":"Request limit reached","storage_full_description":"Please remove old transfers or <a>change your plan</a> to keep receiving.","storage_full_title":"Storage full","tidy_up_description":"Your storage is almost full (%{storage}%). Please remove old transfers or <a>change your plan</a> to keep receiving.","tidy_up_title":"Time to tidy up","upsell_description":"Change your plan to request large transfers from anyone and receive them all in one place.","upsell_user_title":"Receive with ease","user_verified_description":"One last thing—would you like to receive WeTransfer news and product updates?","user_verified_title":"You’re verified!"},"first_interaction":{"window_cta":"Request files","window_description":"Request up to <strong>%{limit}</strong> transfers from anyone. Explain what you need and manage uploads in one place.","window_description_generic":"Request <strong>large files</strong> from anyone. Explain what you need and manage uploads in one place.","window_title":"Receive with ease"},"form":{"add_title_tooltip":"Please add a request title","create_cta":"Create request link","incorrect_email":"It looks like one of the email addresses you entered is incorrect","instructions_field":"Instructions","instructions_field_secondary_label":"Help people send you the right files...","optional":"(optional)","recipients_field":"Notify via email","recipients_field_count_multiple":"+%{recipient_count} others","recipients_field_count_single":"+1 other","recipients_field_limit_reached":"Recipient limit reached","recipients_field_secondary_label":"Add up to %{email_count} emails","recipients_field_secondary_label_limit_reached":"You already added %{email_count} emails","send_cta":"Send request","title_field":"Title","title_field_secondary_label":"What are you requesting?"},"header":"Request files","storage":"Up to %{storage}","storage_upsell":"Increase","success":{"copy_cta":"Copy link","create_new_cta":"Create new request","link_copied":"Link copied to your clipboard","recipient_single":"%{recipient}","recipients_summary_multiple":"We notified<br/> %{recipients} and %{count} others","recipients_summary_single":"We sent your request to<br/>","request_title":"%{request_title}","title":"You\'re ready to receive"}},"request_list":{"cancel_delete":"Cancel","close_request":"Close request","copy_request_link":"Copy link","created_date":"Created %{date}","delete_request":"Delete","delete_request_confirmation":"Are you sure you want to delete this request?","no_results":{"entitled_body":"Request up to %{transferSizeLimit} transfers from anyone.<br>Explain what you need, track activity, and manage uploads in one place.","entitled_body_unlimited":"Request large transfers from anyone.<br>Explain what you need, track activity, and manage uploads in one place.","entitled_title":"Find your file requests here","unentitled_body":"Change your plan to request large transfers from anyone and receive them all in one place.","unentitled_cta":"Compare plans","unentitled_title":"Receive with ease"},"no_uploads":"No uploads yet","number_of_requests_one":"%{count} open request","number_of_requests_other":"%{count} open requests","open_request":"Open request","recipient_notified_multiple_one":"%{email} and %{count} other notified","recipient_notified_multiple_other":"%{email} and %{count} others notified","recipient_notified_single":"%{email} notified","request_status_closed":"Closed requests","request_status_open":"Open requests","transfer_received_date":"Transfer received %{date}","transfers_received_one":"%{count} transfer received","transfers_received_other":"%{count} transfers received"},"request_upload":{"form":{"transfer":"Transfer","validation_exceeded_allowed_size":"The total size of the files exceeds the limit","validation_exceeded_available_storage":"The requester does not have enough storage to accept this upload"},"instructions":{"add_files":"Add files","requester_requests":"%{requesterName} requests"},"progress_one":"Sending %{count} file to %{requesterName}","progress_other":"Sending %{count} files to %{requesterName}","report_request":"Report this request","view_instructions":"View request instructions","view_request":"View request"},"request_upload_stress_states":{"cta_try_again":"Try again","default_title":"Request not available","not_found":"This request does not exist","request_closed":"This request has been closed. Please contact the original requester.","server_error":"Something’s gone wrong on our end. We’re working on it, so please try again later.","storage_limit_reached":"Please contact the original requester","upload_limit_reached":"This request has reached its upload limit. Please contact the original requester."},"request_upload_success":{"action_link":"Send another","description":"Your transfer has been sent and %{requester} has been notified","logged_in_cta":"Request files","title":"You’re done!","upsell_cta":"Upgrade","upsell_label":"Want to request files?"},"request_workspace_invitation":{"modal":{"cta":"Ask access","secondary_cta":"Back to limited options"},"navbar_button_one":"%{count} colleague","navbar_button_other":"%{count} colleagues","no_thanks":"No, thanks","toasts":{"error_already_invited":"%{email} has already been invited to this workspace.","error_already_member":"%{email} is already a member of this workspace.","error_invalid":"This invite request is not valid.","error_permissions":"You must be an administrator to accept invite requests for this workspace.","error_wrong_workspace":"You\'re not currently logged in to the workspace this request is for."},"tw":{"description":"We noticed you\'re part of <b>%{emailDomain}</b>. Getting started is easy! Request access now to your IT manager and unlock unlimited features.","request_sent_cta_dismissable":"Continue","request_sent_cta_navbar":"Got it","request_sent_description":"We sent an access request to your IT manager.","request_sent_description_dismissable":"While we wait for their approval, let’s focus on your transfer.","request_sent_description_navbar":"You will receive an invitation email once they approve your request.","request_sent_title":"Request sent","title":"🎉 You\'re Almost There!"}},"resources_hub":{"breadcrumb":{"aria_label":"Breadcrumb","home":"Home"},"browse":{"detail_aria_label":"%{intention} resources","explore_heading":"Explore the collection","intentions":{"albums":{"description":"Bring group photos and videos together, then share, collect, and manage them in one place.","meta_description":"Create shared photo and video albums with WeTransfer. Find resources on sharing links, QR codes, and collecting media from a group."},"branded-file-transfer":{"description":"With WeTransfer Ultimate, make every delivery feel like yours with branded transfers, custom backgrounds, and an upload portal.","meta_description":"Create branded file transfers with WeTransfer Ultimate. Learn about custom backgrounds, upload portals, and client delivery."},"comparison":{"description":"Find the file-sharing setup that suits your workflow, with clear comparisons between WeTransfer and other tools.","meta_description":"Compare WeTransfer with file-sharing alternatives. See how tools differ for sending large files, security, and collaboration."},"drag-drop-file-upload":{"description":"Drop files straight into your browser and get them moving, whether you are sending one asset or a whole folder.","meta_description":"Use drag-and-drop uploads with WeTransfer. See how to send files, folders, and creative work from your browser."},"edit-comment-on-transfers":{"description":"Keep every transfer moving with file previews, comments, and clear updates for everyone involved.","meta_description":"Edit transfer details and comment on shared files with WeTransfer. Manage feedback and previews in one place."},"file-download-tracking":{"description":"Enable download tracking to see when people download your files, then follow up with confidence.","meta_description":"Track file downloads with WeTransfer. When enabled, see who downloaded your files and when."},"file-sharing-custom-domain":{"description":"With WeTransfer Ultimate, give clients a file-sharing space that looks and feels like your own, from a custom subdomain to the upload page.","meta_description":"Send files from a branded WeTransfer subdomain. Create a familiar upload space that clients recognize."},"file-sharing-with-expiration":{"description":"Decide when files should expire, or keep them available with WeTransfer Ultimate.","meta_description":"Share files with an expiry date. Learn how to set one or keep files available with WeTransfer Ultimate."},"file-transfer-with-preview":{"description":"Let people preview images, video, audio, and PDFs in the browser before they decide what to download.","meta_description":"Preview files before downloading with WeTransfer. Share images, video, audio, and PDFs for review in the browser."},"file-view-tracking":{"description":"See how many times your transfer was opened, then enable access controls to see who viewed it and when.","meta_description":"Track file views with WeTransfer. See how many times a transfer was viewed, or enable access controls to see who viewed it."},"free-file-transfer":{"description":"With a free WeTransfer account, share photos, videos, documents, and more from your browser, without another app.","meta_description":"Transfer files for free with a WeTransfer account. Send photos, video, documents, and more without email attachments."},"manage-file-transfers":{"description":"Browse your past transfers, make updates, and stay on top of the files you sent.","meta_description":"Manage sent transfers with WeTransfer. Rename transfers, share links, check downloads, and update passwords or expiry dates."},"mobile-file-transfer":{"description":"Keep files moving wherever work happens, from your phone, tablet, or any browser.","meta_description":"Send and receive files on mobile. Share photos, video, and documents from any browser with WeTransfer."},"password-protected-file-transfer":{"description":"Add an extra layer of privacy when the files you share are only for certain eyes.","meta_description":"Password-protect file transfers with WeTransfer. Keep shared links private and control who can access your files."},"permanent-file-sharing":{"description":"With WeTransfer Ultimate, keep transfers available for as long as you need, until you delete them.","meta_description":"Keep shared files available with WeTransfer Ultimate. Learn about long-term sharing and transfers with no expiry date."},"recover-expired-transfer":{"description":"With WeTransfer Ultimate, an expired transfer does not always mean the files are gone. Recover it or resend the link.","meta_description":"Recover expired transfers with WeTransfer Ultimate. Learn about recovery options, resending links, and missed downloads."},"request-files":{"description":"Give clients and collaborators with a free account one upload link to send files your way, then collect them in your workspace.","meta_description":"Request files with upload links. Collect files in your WeTransfer workspace from clients and collaborators with a free account."},"request-payment-for-content":{"description":"Share your work, set the price, and let clients pay before they download.","meta_description":"Request payment before files are downloaded. See how paid transfers support client delivery through WeTransfer."},"secure-file-sharing-workspace":{"description":"With WeTransfer Teams, give your team a secure, shared space to send files, manage access, and work with confidence.","meta_description":"Share files securely with WeTransfer Teams. Find information on access controls, shared branding, and sensitive projects."},"send-and-sign-documents":{"description":"Send documents for signature, give signers a simple link, and keep approvals moving.","meta_description":"Send documents for e-signature. Learn how to add signature fields and collect signed documents with WeTransfer Sign."},"send-large-files":{"description":"Send the files that email cannot handle, from high-resolution media to entire project folders.","meta_description":"Send large files with WeTransfer. Share any file type at its original quality with a unique download link."},"send-multiple-files":{"description":"Send multiple files and folders in a single transfer, without having to split up what you need to share.","meta_description":"Send multiple files and folders with WeTransfer. Keep projects organized and preserve original file quality."},"share-files-download-link":{"description":"Share your files with one unique download link, ready to send wherever your recipients are.","meta_description":"Share files with a download link. Send files quickly and let recipients download directly from the browser on WeTransfer."},"share-files-via-email":{"description":"Send files directly to recipients\' inboxes with a download link, without relying on a standard attachment.","meta_description":"Share files via email with WeTransfer. Deliver a download link directly to recipients\' inboxes and avoid attachment limits."},"share-files-with-clients":{"description":"Deliver work to clients in a way that feels polished, clear, and easy to review.","meta_description":"Share files professionally with clients. Use WeTransfer for delivery, feedback, and access controls."}},"meta_title":"%{intention} | WeTransfer","translations_label":"Also available in","translations_toggle_aria":"Show translations for %{title}"},"index":{"detail_aria_label":"Choose a resource","generic_shortcut_description":"Explore resources for %{intention}.","guidance":"Pick a common use case from the shortcuts below, or browse the full list on the left for more options.","heading":"What do you want to do?","meta_description":"Find the WeTransfer page for what you want to do, from sending large files to password-protecting a transfer.","meta_title":"Resources | WeTransfer","popular_shortcuts_title":"Popular shortcuts"},"rail":{"all_label":"All resources","aria_label":"Resources","close_menu":"Close menu","no_results":"No matching resources found","open_menu":"Open menu","popular_label":"Popular","search_clear":"Clear search","search_placeholder":"Search resources","title":"Resources"}},"saml_sso":{"claimed_domains":{"description1":"Only users with email addresses from verified domains will be required to authenticate with SSO. If a domain is not verified, its users will not be affected.","description2":"To verify a domain, add a TXT record to your domain\'s DNS settings with the verification string assigned to it. Then, ask your WeTransfer contact to confirm verification.","empty_state_body":"Reach out to your WeTransfer contact","empty_state_title":"No domains added","info_banner":"SSO is enforced only for members whose email domain matches one of the verified domains listed. Subdomains are automatically included unless assigned to another team.","not_verified":"Not verified","title":"Claimed domains","verification_string":"Verification string","verified":"Verified"},"copy":"Copy","head_title_scim":"SSO and SCIM - WeTransfer","head_title_sso":"SSO - WeTransfer","scim":{"active":"Active","bearer_token":"Bearer token","bearer_token_description":"Generate your token, copy and provide it to your identity provider or other SCIM client.","configuration_endpoints":"Service Provider Configuration Endpoints","delete_token":"Delete token","delete_token_modal":{"cancel":"Cancel","delete":"Delete token","description":"Are you sure you want to permanently delete this token? This action cannot be undone.","title":"Delete token?","token":"Token: <0>%{token}</0>"},"description":"Manage user provisioning and deprovisioning with SCIM (System for Cross-domain Identity Management). Configure SCIM settings to automate user access and keep your directory in sync.","enable":"Enable SCIM","endpoint_url":"SCIM Endpoint Url (Tenant URL)","expired":"Expired","expired_date":"Expired on %{date}","expires_date":"Expires on %{date}","generate_new_token":"Generate new token","generate_token_modal":{"cancel":"Cancel","checkbox_label":"No expiration time","generate":"Generate token","text_field_caption":"Enter a value greater than or equal to %{seconds} seconds.","text_field_label":"Expiration time in seconds","title":"Generate a new bearer token"},"no_expiration_date":"No expiration date","title":"SCIM"},"sso":{"acs_url":"ACS URL","certificate":"Certificate","certificate_invalid":"Invalid certificate","description1":"Configure Single Sign-On (SSO) settings for secure authentication. Enter the SSO URL and certificate to enable seamless login for all members in your workspace.","description2":"We use the HTTP Redirect binding for the SP to IdP flow and the HTTP Post binding for the IdP to SP flow.","description3":"The entire SAML Response must be signed.","disable":"Disable SSO","entity_id":"Entity ID","name_id":"NameID format","save_enable":"Save and enable","sso_url":"SSO URL","sso_url_invalid":"Invalid SSO URL","title":"SSO","update":"Update"},"title_scim":"Security"},"sanitization":{"and_others":"and %{count} more"},"shortcuts":{"cmd_alt_l":"⌘-Alt-L","cmd_c":"⌘-C","cmd_j":"⌘-J","cmd_shift_j":"⌘-Shift-J","control_alt_l":"Ctrl-Alt-L","control_c":"Ctrl-C","control_j":"Ctrl-J"},"showcase":{"accessible_label":"Custom background","apply_changes":{"cancel":"Cancel","current_label":"Live version","description":"You can use this background just for this transfer,","description_secondary":"or save it to your brand settings for all future transfers.","new_label":"Your changes","save_to_brand":"Save for all transfers","save_to_brand_disabled":{"max_previews_wallpapers":"You\'ve reached the maximum of 5 saved preview wallpapers. Remove one from your brand settings first","max_wallpapers":"You\'ve reached the maximum of 5 saved wallpapers. Remove one from your brand settings first","multi_image":"Split backgrounds cannot be saved to brand settings. Use a single image instead","no_access":"Upgrade to a paid plan to save backgrounds to your brand settings","no_images":"Only images can be saved to brand settings. Select an image instead of a solid color","video_background":"Video backgrounds cannot be saved to brand settings. Use an image instead"},"title":"How would you like to use this background?","use_for_transfer":"Use for this transfer"},"background_image":{"alternative_text":"Transfer background image"},"background_video":{"alternative_text":"Transfer background video"},"editor":{"backgroundAsset":{"add_more":"Add more","cta":{"restore":"Restore original","upload":"Upload new - 5 MB max"},"error":"An error occurred while trying to upload your new background, please try again.","file_too_large":"This file exceeds the 5 MB limit. Please choose a smaller file.","from_your_transfer":"From your transfer","invalid_format":"This file format isn\'t supported. Please upload a JPG, PNG, or MP4 file.","invalid_format_image_only":"This file format isn\'t supported. Please upload a JPG or PNG file.","invalid_image":"This file is too big, or not a png or jpg format - try a different image","label":{"image":"Media","solid":"Solid color"},"max_images_reached":"You can select a maximum of 6 images","max_previews_images_reached":"You can only select 1 image for previews","multi_image_banner":{"description":"Now you can add more than one image as a background. Try it out!","title":"Why choose just one?"},"panel_label":"Download page cover","previews_panel_label":"Previews cover","uploaded_background":"Uploaded background","uploaded_background_tooltip":"Those background images won\'t be included in your transfer","video_too_long":"This video exceeds the 30-second limit. Please choose a shorter video."},"color_palette":{"black":"black","blue":"light blue","coral":"light coral","gray":"gray","green":"green","lavender":"light lavender","lite_green":"pale lime green","red":"bright salmon","white":"white","yellow":"sunflower yellow"},"device_preview_selector_label":{"desktop":"Desktop preview","mobile":"Mobile preview"},"image":{"panel_label":"Image"},"multi_image_layout":{"columns":"Columns","rows":"Rows"},"preview_label":{"download_page":"Download page","previews":"Previews page"},"selection_label":{"background":"Download page cover","text":"Text"},"text":{"banner_description":"If you add a description, we\'ll show it on both the Download and Preview pages.","banner_title":"Where will this appear?","label_description":"Description","label_title":"Title","panel_label":"Text","placeholder_body_editor":"Add more text","placeholder_body_viewer":"Add more text to highlight or add detail to the files you\'re sending.\\n\\nYou could also include information about yourself or your business. Whatever helps make an impact—the choice is yours.","placeholder_title":"Add a title"}},"modal":{"actions":{"cancel":{"confirmation":{"cancel_button_label":"No, keep editing","confirm_button_label":"Yes, cancel","prompt":"Are you sure you want to close this editor? The changes you made will be lost."},"label":"Cancel"},"delete":{"confirmation":{"cancel_button_label":"Cancel","confirm_button_label":"Delete","prompt":"Hold up – are you sure you want to delete this custom background? If you do, the default background will show instead."},"label":"Delete"},"save":{"label":"Apply"}},"auto_open_free_title":"Try out a custom background for free","description":"This is what people will see when they open this transfer link. You can select up to 6 images, a single video, or a solid color as a background.","reset":"Reset template","title":"Customize background"},"previews_skeleton":{"title_tooltip":"You can edit the transfer title directly in the preview page or in the transfer details page"},"transfer_details":{"cover_block_title":"Your custom background","delete_cover_button_label":"Delete","delete_cover_confirmation":{"cancel":"Cancel","confirm":"Delete","text":"Are you sure you want to delete this background?"},"edit_cover_button_label":"Edit","empty_cover_button_label":"Add background","empty_cover_title":"Make your transfer <strong>stand out!</strong>","section_heading":"Custom background"},"transfer_window_option":{"cta":"Customise transfer cover","label":"Cover design","pill":"New"}},"showcase_portfolio":{"add_work":{"adding":"Adding to your Showcase…","cancel":"Cancel","drop_hint":"or browse files · JPG, PNG, MP4, MOV, WAV, MP3","drop_note":"New uploads won’t be saved in WeTransfer and will be used only for your Showcase.","drop_title":"Drag images & videos here","error":"Something went wrong uploading your work. Please try again.","new_files_one":"%{count} new file","new_files_other":"%{count} new files","selected_one":"%{count} file selected","selected_other":"%{count} files selected","submit":"Add to Showcase","title":"Add content to your Showcase","too_many":"You’ve reached the maximum number of files for your showcase","unsupported_one":"%{count} file wasn’t added: a Showcase takes photos, videos and audio only.","unsupported_other":"%{count} files weren’t added: a Showcase takes photos, videos and audio only.","upload_more":"Upload more","upload_progress":"%{percent}% uploaded","upload_tip":"Tip: you can reorder your images in the layout however you like!","uploaded_amount":"%{uploaded} of %{total} uploaded","uploaded_files_one":"%{count} file uploaded","uploaded_files_other":"%{count} files uploaded","uploading_label":"Uploading…"},"build":{"about_public_hint":"They will be shown on your public Showcase page.","about_tab":"About you","accent_colour":"Accent colour","accent_swatch":"Accent colour %{color}","add_logo":"Add a logo or icon","add_name":"Add a name","add_new_column":"Add new column","add_new_row":"Add new row","add_to_showcase":"Add to showcase","add_work":"Add work","add_work_hint":"Choose your best work to showcase, up to 20 images or videos","adjust_image":"Adjust image","aspect_ratio":"Aspect ratio","aspect_ratio_auto":"Auto","aspect_ratio_landscape":"Landscape","aspect_ratio_portrait":"Portrait","aspect_ratio_square":"Square","contacts":"Add your contacts","continue_to_resize":"Continue to resize","customize_helper":"Choose how you want your showcase to look!","customize_tab":"Customize","customize_title":"Customize your showcase","dark_mode":"Dark mode","dark_mode_hint":"Show your work on a dark background","delete_permanently":"Delete %{name} permanently","done_resizing":"Done resizing","drag_to_reposition":"Drag to reposition","email":"Your email","last_item":"A published Showcase needs at least one piece of work. Add another before removing this one.","logo_button":"Add","logo_hint":"Optional · PNG, JPG or GIF · max 2MB","logo_replaces_title":"Use logo instead of title","logo_replaces_title_hint":"Your logo will replace the title text on the public page.","max_files_hint":"Remove some files in showcase if you want to add new ones","max_files_title":"You’ve reached the maximum number of files for your showcase","page_subtitle":"Page subtitle","page_title":"Page title","pause_media":"Pause %{name}","phone":"Phone number","play_media":"Play %{name}","readd_work":"Re-add %{name}","recently_removed":"Recently removed","remove_image":"Remove image","remove_logo":"Remove","rename_work":"Rename work","reorder_hint":"Move your files into different rows, up to 3 files per row","reorder_title":"DRAG TO REORDER","reset_crop":"Reset crop","resize_frame":"Resize frame","rights_notice":"You are only allowed to post content you hold rights on and that does not infringe the rights of others.","subtitle_placeholder":"Add a subtitle here","title_placeholder":"Add your title here","toggle_audio":"Play or pause %{name}","upload_new":"Upload new files"},"builder":{"back":"Back","close":"Close","continue_to_customize":"Continue to Customize","continue_to_post_it":"Continue to Post it","create_error":"We couldn’t open your Showcase right now. Please try again.","load_error":"We couldn’t open your Showcase. Please try again.","next":"Next","next_disabled_hint":"Add at least one image and a title to continue","retry":"Try again","save_edits":"Save edits","send_for_review":"Publish","setting_up":"Setting up your Showcase…","step_build":"Build it","step_review":"Publish","step_share":"Post it","step_updated":"Updated","title":"Create your Showcase"},"create_mobile":{"body":"Head to WeTransfer on your computer to create your showcase.","cta":"Got it!","title":"Showcase creation isn’t available on mobile"},"discard":{"body":"Your edits and any work you added here haven’t been saved yet. Leaving now loses them.","discard":"Discard changes","keep":"Keep editing","title":"Discard your changes?"},"download_banner":{"cta":"See showcase","sent_by":"Sent by"},"edit_mobile":{"body":"Head to WeTransfer on your computer to make changes to your showcase.","cta":"Got it!","title":"Showcase editing isn’t available on mobile"},"entry":{"back":"Back to transfer details","card_architecture_title":"Architecture portfolio","card_moments_accent":"that stay","card_moments_title":"The moments","card_showreel_accent":"showreel","card_showreel_title":"David’s 2026","cards_easiest_porftolio":{"subtitle":"Just your work on a beautiful page that builds itself.","title":"Your portfolio, ready in minutes.","vp1_body":"Showcase automatically turns the files you just sent into a gorgeous portfolio page. Easy setup, no design, no hassle.","vp1_title":"Easy setup. Instant results.","vp2_body":"Pick what to show, arrange it your way, and you’ve got a page that actually feels like you.","vp2_title":"Your work, one link"},"cards_general":{"subtitle":"Publish the files you just sent as a beautiful public page: your name, your work, one shareable link. No website to build, ready in under a minute.","title":"Get featured on WeTransfer","vp1_body":"Pick what to show, arrange it your way, and you’ve got a page that actually feels like you.","vp1_title":"Don’t just send it. Show it off.","vp2_body":"Choose to show your Showcase as a WeTransfer wallpaper and reach people far beyond your own transfers.","vp2_title":"Your work, one link"},"cards_get_discovered":{"subtitle":"Your Showcase puts your work in front of people beyond your network.","title":"Get discovered by millions of WeTransfer users.","vp1_body":"Millions of people use WeTransfer every single day. Your Showcase puts your portfolio right in front of them every time someone lands on a transfer.","vp1_title":"Your work, where the audience already is.","vp2_body":"Choose to show your Showcase as a WeTransfer wallpaper and reach people far beyond your network.","vp2_title":"Don’t just send it. Show it off."},"cta":"Create your Showcase","maybe_later":"Maybe later","preview_mock_accent":"showcase","preview_mock_intro":"I hope these photos bring back the same energy and emotion we experienced during the shoot. Enjoy exploring the collection!","preview_mock_title":"Your own","single_preview":{"subtitle":"Publish the files you just sent as a beautiful public page: your name, your work, one shareable link. No website to build, ready in under a minute.","title":"Don’t just send it. Show it off."}},"footer":{"faq":"FAQ","language":"English","made_by":"Made with ♥ by the WeTransfer team"},"landing":{"cta_band_cta":"Create your showcase","cta_band_heading":"Your work deserves the spotlight","example_1_name":"Stephany Decrow","example_1_role":"Architectural photographer","example_1_subtitle":"Architectural photography that reveals the soul of every structure. Finding emotion in steel, glass, and stone.","example_2_name":"Martina Ross","example_2_role":"Wedding photographer","example_2_subtitle":"Wedding photography made of glances, gestures, and laughter","example_3_name":"David Sterling","example_3_role":"Motion designer and videomaker","example_3_subtitle":"Crafted animation for brands and stories.","example_check_her":"Check her showcase","example_check_his":"Check his showcase","examples_body":"Real Showcases from creators like you, each one a window into what they do best.","examples_heading":"Browse some Showcase examples here","faq_a1":"No. The editor is simple, so the page designs itself around your work.","faq_a2":"Opt in and a link rides along on every transfer you send and in its email. A dedicated wallpaper is coming soon.","faq_a3":"Any images, videos or audio you have the rights to use.","faq_a4":"Yes, it’s completely free.","faq_a5":"Straight away. Publish it and your Showcase goes live. We may remove pages that break our content rules.","faq_q1":"Do I need a website or any design skills?","faq_q2":"Where exactly does my Showcase appear?","faq_q3":"What can I put on it?","faq_q4":"Is it free?","faq_q5":"How quickly does my Showcase go live?","faq_title":"Frequently asked questions","hero_discovered_body":"Every file you send is a chance to be remembered. Your Showcase puts your work in front of the people receiving it. Branded, and memorable.","hero_discovered_cta":"Create your Showcase","hero_discovered_heading":"Get discovered by the people you send files to.","hero_easiest_body":"No design skills. No website builder. Just you and your work - on a beautiful page that builds itself.","hero_easiest_cta":"Create your portfolio","hero_easiest_heading":"Your portfolio page, ready in minutes.","hero_general_body":"Showcase turns the files you already send into a clean public page - your name, your work, your contact. No website to build. Showcase is you and your work on WeTransfer!","hero_general_cta":"Create your showcase","hero_general_heading":"One link, show your best work. No expiration.","hero_helper":"About a minute · private until you publish","professional_notice":"Showcase is a product for professional use only. By using Showcase you agree to our <termsLink>Terms of Service</termsLink> and confirm you acknowledge our <privacyLink>Privacy Policy</privacyLink>","seen_body":"Every transfer you send already reaches people. Your Showcase rides along - so anyone who receives your files is one tap from your whole body of work.","seen_discovered_body":"Every transfer you send is a chance to be seen. Your Showcase travels with it - so the people receiving your files are one tap from discovering everything you do.","seen_discovered_heading":"Get discovered by the people your files land with.","seen_easiest_body":"You send files like you always have. Your Showcase just rides along - no site to maintain, no links to paste - reaching everyone who gets your transfers.","seen_easiest_heading":"Shared with every recipient, with zero extra work.","seen_heading":"Seen by the people your files already go to.","visual_body":"Your whole body of work, gathered in one beautiful page that goes wherever your transfers go.","visual_discovered_body":"The people you send files to already open them. Showcase puts your portfolio right there alongside.","visual_discovered_title":"Your work, where your recipients already are.","visual_easiest_title":"Easy setup. Instant results.","visual_eyebrow":"Your work, your page","visual_general_title":"It’s you on WeTransfer"},"manager":{"back":"Back","badge_draft":"Draft","badge_live":"Live","badge_offline":"Disabled","badge_taken_down":"Taken down","callout_hint":"Turn off to take it offline","callout_hint_off":"Turn on to make it public again","callout_title":"Visible to anyone with the link","callout_title_off":"Hidden from everyone","empty":"You don’t have a showcase yet.","link_inactive_offline":"Link inactive while offline","load_error_body":"Something went wrong on our side. Your Showcase is still there.","load_error_title":"We couldn’t load your Showcase","loading":"Loading…","msg_draft":"Your showcase is almost ready. Continue building to add your work, then publish it.","msg_offline":"Your page and its link are inactive while it’s off. Turn it back on to make it public again.","msg_taken_down":"This showcase has been taken down because it doesn’t meet our content rules, and it can’t be put back up. <b>Check your inbox</b> for details.","placement_download":"Download page","placement_email":"Confirmation email","placement_wallpaper":"Wallpaper","preview":"Preview my showcase","removed_contact":"Contact support","taken_down_at":"Taken down %{time}","title":"Your showcase","turned_off":"Turned off %{time}","updated":"Updated %{time}","where":"Where it appears"},"onboarding":{"about_body":"Add your contacts so visitors know who’s behind the work, or upload more files if you like.","about_title":"About you","add_work_body":"Add up to 20 images or videos. Nothing is published yet, and you can review everything before you decide to go live.","add_work_cta":"Add work","add_work_title":"Start with your work","continue_cta":"Continue","counter":"%{current} of %{total}","customize_body":"Add your logo, pick an accent colour, and switch on dark mode to make your page unmistakably yours.","customize_title":"Give it the finishing touch","ready_body":"Happy with the details? Press Next to review everything and decide whether to publish.","ready_cta":"Got it","ready_title":"You’re ready","reorder_body":"Drag the media to reorder it and change the layout.","reorder_title":"Make it yours","skip":"Skip","title_body":"Choose a title and subtitle to sit at the top of your page.","title_title":"Give it a title"},"preview":{"banner":"Showcase preview, not live yet","close":"Close preview"},"public":{"close":"Close","create_showcase":"Create your Showcase","email":"Email","featured_body":"Publish the files you just sent as a beautiful public page: your name, your work, one shareable link. No website to build, ready in under a minute.","featured_heading":"Get featured on WeTransfer","more_options":"More options","next":"Next","offline_body":"This page isn’t public right now. If it’s yours, sign in to see its status.","on_wetransfer":"on WeTransfer","phone":"Phone number","previous":"Previous","report":"Report this page","unavailable_body":"This page has been removed and can’t be viewed. If it’s yours, sign in to see its status.","unavailable_cta":"Go to WeTransfer","unavailable_title":"This Showcase isn’t available"},"review":{"check_guidelines_desc":"Make sure to upload only real, appropriate work that fits WeTransfer’s content rules.","check_guidelines_title":"Meets our guidelines","check_yours_desc":"Only publish work you own or have the rights to use.","check_yours_title":"Really yours","copied":"Copied","copy":"Copy","edit":"Edit","edit_submission":"Edit showcase","error":"We couldn’t submit your Showcase. Please check the details and try again.","open_showcase":"Open showcase","preview_submission":"Preview my showcase","published_note":"Your Showcase is live. Share the link anywhere you like. You can edit it any time, and changes go live straight away.","published_title":"You’re live!","updated_note":"Your edits are saved and your Showcase is already showing the new version. Go take a look.","updated_title":"All updated!"},"share":{"coming_soon":"Coming soon","disabled":"Disabled","download_page_desc":"On the page where people grab your files, right beside the download button.","download_page_label":"Download page","email_desc":"Tucked into the “your files are ready” email everyone receives.","email_label":"Confirmation email","enable":"Show my Showcase here","enabled":"Enabled","handle_error_fallback":"Could not update the URL, please try again.","handle_label":"Your showcase URL","handle_save":"Save URL","handle_saving":"Saving...","mock_add_files":"Add files","mock_add_folder":"Add folder","mock_check_showcase":"Check %{name}’s showcase","mock_download":"Download","mock_download_link":"Download link","mock_email_file_count":"2 files","mock_email_file_meta":"3 MB · pdf","mock_email_file_name":"Carbonara Recipe","mock_email_meta":"2 items, 751 KB in total · Expires on 22 November, 2025","mock_email_sent_you":"sent you","mock_email_to":"Email to","mock_email_url":"https://wetransfer.com/downloads/1234556","mock_expires_24h":"Transfer expires in about 24 hours","mock_expires_in":"Expires in","mock_files_ready":"Your files are ready","mock_full_name":"Stephany Decrow","mock_get_files":"Get your files","mock_go_to_showcase":"Go to showcase","mock_increase":"Increase limit","mock_items_received":"%{count} items received","mock_make_your_own":"Make your own","mock_malware_safe":"Transfer scanned and free from malware!","mock_more_from_user":"More from this user?","mock_open":"Open","mock_see_showcase":"See their showcase","mock_see_showcase_short":"See showcase","mock_sent_by":"Sent by","mock_title_message":"Title and message","mock_transfer":"Transfer","mock_up_to_free":"Up to 2 GB free","mock_view_showcase":"View showcase","mock_wallpaper_intro":"I hope these photos bring back the same energy and emotion we experienced during the shoot. Enjoy exploring the collection!","mock_your_email":"Your email","note":"Where should people see your Showcase?","protip_badge":"Pro tip","protip_body":"Do it from your WeTransfer <a>profile page</a>.","protip_download_title":"Want to change the name and the profile pic shown in the download page?","protip_email_title":"Want to change the name and the profile pic shown in the email?","protip_wallpaper_title":"Want to change the name and the profile pic shown in the wallpaper?","review_banner_body":"Publish and your Showcase goes live straight away.","review_banner_title":"Ready to publish","title":"Pick your placements","wallpaper_desc":"A WeTransfer wallpaper that links straight to your page.","wallpaper_label":"Dedicated wallpaper"}},"site":{"descriptions":{"default":"The simple, quick and secure way to send your files around the world without an account. Share your files, photos, and videos today for free.","help":"Need WeTransfer tech support? Find out how to send large files in our Quick Help section or get in touch.","pricing":"Get affordable pricing for WeTransfer. Share large files and photos online, and transfer up to 2GB free. Simple file sharing made easy!","sign_in":"Login to WeTransfer and start sending files easily and securely. Sign in to access your files from anywhere. Try WeTransfer today!","sign_up":"Create your WeTransfer account and start sharing files easily. Sign up for WeTransfer and enjoy the best file transfer service available.","social_help":"Still haven’t found what you’re looking for?","transfers":"Quickly and securely transfer files with our easy-to-use platform. Send files of any size, anytime, anywhere with WeTransfer\'s reliable service.","wetransfer_sign":"The simplest, most accessible way to get documents signed. WeTransfer Sign is free, secure, and ready for anyone to use instantly."},"name":"WeTransfer","titles":{"about":"About | WeTransfer","advertise":"Advertise with us | WeTransfer","apps":"Free apps for Mac, iOS and Android | WeTransfer Apps","default":"WeTransfer | Send Large Files Fast","forgot_password":"Reset your password | WeTransfer Pro","help":"How to send large files | WeTransfer Help","home":"Share large files easily for free | WeTransfer","plus":"Upgrade to send bigger files | WeTransfer Pro","preview_link":"Preview Link | WeTransfer","pricing":"Pricing | WeTransfer - Send Large Files & Share Photos Online","sign_in":"Log in | WeTransfer","sign_up":"Sign up | WeTransfer Pro","transfers":"File Transfers: The WeTransfer File Sharing Hub | WeTransfer","unique_download_link":"Unique Download Link | WeTransfer","unique_transfer_link":"Unique File Transfer Link | WeTransfer","upgrade":"Upgrade | WeTransfer Pro","verify_mobile":"Mobile File Transfer & Verification | WeTransfer","wetransfer_sign":"WeTransfer Sign | Get your documents signed in seconds, for free."}},"storage_probe":{"cloud_picker":{"destinations":{"dropbox":"Save to Dropbox","google_drive":"Save to Google Drive","onedrive":"Save to OneDrive","wetransfer":"Save to WeTransfer Storage"},"title":"Where would you like to save your files?"},"cta":{"cloud_storage":"Save to Cloud Storage","wt_storage":"Save to WeTransfer Storage"},"popover":{"cloud_storage":{"body":"Build your personal archive on WeTransfer. Keep the files you care about safe, organized and ready to share instantly anytime.","title":"A home for the work that matters."},"wt_storage":{"body":"Build your personal archive on WeTransfer. Keep the files you care about safe, organized and ready to share instantly anytime.","title":"A home for the work that matters."}},"working_modal":{"body":"We\'re building the finishing touches on WeTransfer Storage. Want to know when they\'re ready?","close":"Close","notify_cta":"Notify me","title":"We\'re working on it"}},"subscription_card":{"compare_plans":"Compare all plans","discount_subtitle":"We applied a discount on your next renewal. Enjoy!","discount_title":"%{discount}% discount on your next renewal","downgrade":{"current_solo_workspace_information":"Your current plan will automatically be downgraded on <b>%{autorenewalattempt}</b>","current_team_workspace_information":"Your current plan will automatically be downgraded on <b>%{autorenewalattempt}</b>"},"paused_subscription_text":"Your subscription is paused. You won\'t be charged during this time, and you\'ll keep full access to all features. At the end of the pause period, it will automatically resume. If you don\'t cancel before, the next renewal will be on <b>%{date}</b>.","pending_cancellation":"Your workspace subscription has been cancelled and will end on <0>%{cancellationDate}</0>. Changed your mind? Don’t panic, it’s easy to get things back up and running.","pending_price_change":"Your previous plan has been discontinued—but don\'t worry! You still have access to the all features of your previous plan, plus some new ones unique to the %{plan} plan, at no extra cost until your next renewal on %{renewal_date}. We\'ll send you a reminder 30 days before your renewal, or you can learn more about these changes <a href=\'%{support_url}\' target=\'blank\'>here</a>.","reactivate_cta":"Reactivate","solo_workspace":"Your current plan of <b>%{formattedintervaltotal}</b>/%{subscriptioninterval} will automatically renew on <b>%{autorenewalattempt}</b>","solo_workspace_price_increase":"Your current plan will automatically renew on <b>%{autorenewalattempt}</b> for <b>%{formattedintervaltotal}</b>/%{subscriptioninterval}","team_workspace":"Your current plan of <b>%{formattedTeamWorkspaceCost}</b>/%{subscriptioninterval} (%{membercount} x %{tieramount}) will automatically renew on <b>%{autorenewalattempt}</b>"},"surveys":{"banner":{"intro_text":"Help us improve WeTransfer.","link_text":"Take our 1-minute survey."},"option_no":"No","option_other":"Other","option_skip":"Skip","option_yes":"Yes","thank_you_toast_text":"Thank you for answering!","user_research":{"content":"We’re dedicated to making WeTransfer the best it can be, and we need your help! Let us know what we can improve.","skip_survey_cta_text":"No, thanks","take_survey_cta_text":"Let’s take the survey","title":"Help us improve WeTransfer!"}},"team_policies_settings":{"description":"Add an extra layer of security on your workspace by enforcing rules on all members of your organization.","settings":{"block_recoverability":{"description":"Transfers can\'t be recovered after they expire.","title":"Block transfer recovery"},"email_transfer_only":{"description":"Link transfers are disabled.","title":"Email transfers only"},"enforce_password":{"description":"All transfers must be protected by a password.","title":"Mandatory password"},"max_transfer_expiration":{"description":"Set a maximum expiration window for all transfers in this workspace.","option_one":"%{days} day","option_other":"%{days} days","option_year":"1 year","title":"Limit maximum transfer expiration window"},"min_access_control":{"description":"Set a minimum access-control level for all transfers in this workspace.","option_restricted":"Restricted only","option_tracked":"Tracked or restricted","title":"Limit transfer access control"}},"title":"General rules"},"team_policy_error":{"block_link":{"cta":"Change to email transfer","text":"Your workspace doesn\'t allow link transfers. Contact your admin for details.","title":"Let\'s keep your transfers safe"},"enforce_password":{"cta":"Set a password","text":"Your workspace requires password-protected transfers. Contact your admin for details.","title":"Let\'s keep your transfers safe"},"max_expiration_exceeded":{"cta":"Change expiration","text":"Your workspace admin has set a maximum transfer expiration. Choose a shorter one and try again.","title":"Expiration too long"},"min_access_control_violated":{"cta":"Change access control","text":"Your workspace admin requires a stricter access-control level. Choose a different one and try again.","title":"Let\'s keep your transfers safe"},"recoverability_blocked":{"cta":"Turn off recovery","text":"Your workspace doesn\'t allow recoverable transfers. Contact your admin for details.","title":"Let\'s keep your transfers safe"}},"tiers_2024":{"basic":"Basic","basic_plan":