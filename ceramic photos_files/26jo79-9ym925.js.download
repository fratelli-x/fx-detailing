er_notify_sender_on_preview_description":"Get an email when someone previews your transfer for the first time","transfer_notify_sender_on_preview_label":"A transfer you sent has been previewed"},"received":{"notify_recipient_on_transfer_received_description":"Get an email when someone sends you a transfer. You\'ll still see all transfers you receive in your received transfers list.","notify_recipient_on_transfer_received_label":"You received a transfer"},"sound":{"description":"Play a sound when your transfer has finished uploading and you\'re not on the upload page","label":"Upload completion sound"},"tracked_disclaimer_description":"When the tracked option is enabled, you will receive detailed notifications for every download of that transfer.","tracked_disclaimer_title":"This setting does not affect transfers that use Tracked access control","updates":{"notify_on_updates_description":"Receive emails about service updates and promotional offers","notify_on_updates_label":"Updates and promotions"},"updates_notifications_heading":"WeTransfer updates","upload":{"transfer_notify_sender_on_upload_success_description":"Get an email when your transfer has been successfully uploaded and sent to your recipients.","transfer_notify_sender_on_upload_success_label":"Your transfer has been sent"}},"nudge_starter_to_ultimate_ft_banner":{"cta":"Try Ultimate for Free","features":{"password_tracking":"Complete control over settings","remove_after_expiry":"Recover files after expiry","unlimited_transfers":"Unlimited transfers and GBs"},"subtitle":"Join thousands of creators and get <strong>7 days of Ultimate free</strong>. Cancel anytime, no commitment.","title":"Get your gift: 7 days of free Ultimate!"},"nudge_starter_to_ultimate_ft_modal":{"cta":"Try Ultimate for Free","features":{"password_tracking":"Full control over transfer settings","remove_after_expiry":"Recover files after expiry","unlimited_transfers":"Unlimited transfers and GBs"},"subtitle":"You picked Starter, but why not try <b>7 days of Ultimate</b>, completely free? Cancel anytime, zero commitment.","title":"Don\'t miss out on more power!"},"number":{"currency":{"AUD":"aud","BR":"R$","CAD":"CA$","DKK":"kr","EUR":"€","GBP":"£","MXN":"$","NOK":"kr","SEK":"kr","USD":"US$","format":{"delimiter":",","format":"%u%n","precision":"2","separator":".","significant":"false","strip_insignificant_zeros":"false","unit":"$"}},"format":{"delimiter":",","precision":"3","round_mode":"default","separator":".","significant":"false","strip_insignificant_zeros":"false"},"human":{"decimal_units":{"format":"%n %u","units":{"billion":"Billion","million":"Million","quadrillion":"Quadrillion","thousand":"Thousand","trillion":"Trillion","unit":""}},"format":{"delimiter":"","precision":"3","significant":"true","strip_insignificant_zeros":"true"},"storage_units":{"format":"%n %u","units":{"byte":{"one":"Byte","other":"Bytes"},"byte_one":"Byte","byte_other":"Bytes","eb":"EB","gb":"GB","kb":"KB","mb":"MB","pb":"PB","tb":"TB"}}},"percentage":{"format":{"delimiter":"","format":"%n%"}},"precision":{"format":{"delimiter":""}}},"order_confirmation":{"subject":"Order confirmation for %{productName}","thank_you_header":"Thank you for purchasing %{productName}","thank_you_text":"Thank you for your purchase of <strong>%{productName}</strong> from %{creatorFullName}. You can access your content via the button below"},"other":{"days":"days","hours":"hours","weeks":"weeks"},"outage":{"generic":"<0>We\'re on it!</0> 🚧 We\'re aware of an issue affecting wetransfer.com and are working to fix it as quickly as possible. Thanks for your patience! 💙","status_page_cta":"Check status"},"ownership_transfer":{"banner":{"cancel_request":"Cancel request","complete_transfer":"Complete transfer","former_member":"a former member","pending":"You asked %{memberName} to take over ownership of %{teamName}. We will let you know when they accept.","ready":"%{memberName} accepted your ownership transfer request. Complete the transfer to finalise the swap. This action cannot be undone."},"cancel_modal":{"body":"<strong>%{memberName}</strong> will no longer be able to accept this transfer, and will be notified the request was cancelled. You can start a new request at any time.","confirm":"Cancel request","header":"Cancel ownership transfer request?"},"errors":{"already_active":"%{teamName} already has an active ownership transfer request. Cancel the existing request before creating a new one.","generic":"Something went wrong. Please try again, or contact support if the issue persists.","swap_failed":"We could not complete the ownership transfer. Both accounts have been restored to their previous state. Please try again, or contact support if the issue persists.","target_not_eligible":"%{memberName} signs in with Google / Apple / Slack / SSO. Ownership transfer is not available for these accounts.","target_not_member":"%{memberName} is no longer a member of %{teamName}. The ownership transfer cannot be completed."},"execute_modal":{"bullet_password_mfa":"Any password and MFA on either account are reset. You can set a new password and re-enable MFA from account settings after signing in.","bullet_routing":"You will keep signing in with your own email as usual, but it will take you into %{memberName}\'s account from now on. The next time you sign in you\'ll receive a one-time code on your email to authenticate.","bullet_signout":"Both accounts will be signed out immediately.","bullets_intro":"Once you confirm:","complete":"Complete ownership transfer","header":"Complete ownership transfer","intro":"You are about to complete the ownership transfer of <strong>%{teamName}</strong> to <strong>%{memberName}</strong> (%{memberEmail}).","irreversible":"<strong>This cannot be undone.</strong>"},"initiation_modal":{"bullet_password_mfa":"Any password or MFA on either account is reset. The next time either of you signs in, you\'ll authenticate with a one-time code sent to your email; you can set a new password and re-enable MFA from account settings after that.","bullet_routing":"You will keep signing in with your own email as usual, but it will take you into %{memberName}\'s account, with all their personal transfers, history and settings.","bullet_takeover":"%{memberName} will take over your account, with all your personal transfers, history and settings, and become the new owner of %{teamName}.","bullet_workspace_intact":"The workspace, its members, subscription and billing are not affected.","bullets_intro":"If %{memberName} accepts and you complete the ownership transfer:","confirm_input_label":"Type TRANSFER OWNERSHIP to confirm","confirm_instructions":"Type <code>%{phrase}</code> to confirm.","data_access":"Before confirming, you can <a>request a copy of your data or delete it</a>.","header":"Transfer workspace ownership","intro":"You are about to ask <strong>%{memberName}</strong> (%{memberEmail}) to take over ownership of <strong>%{teamName}</strong>.","send_request":"Send request","warning":"<strong>This is an identity swap, not just a role change.</strong>"},"member_action":{"transfer_ownership":"Transfer ownership"},"target":{"accepted":"You accepted the request. We will let you know when the workspace owner completes the transfer. Until then, nothing changes on your account.","invalid":"This ownership transfer request is no longer valid. Ask the workspace owner to send a new request if you still want to proceed.","review":{"accept":"Accept","bullet_handed_over":"The workspace owner will take over your account, with all your personal transfers, history and settings.","bullet_password_mfa":"Any password or MFA on either account is reset. The next time either of you signs in, you\'ll authenticate with a one-time code sent to your email; you can set a new password and re-enable MFA from account settings after that.","bullet_takeover":"You will keep signing in with your own email as usual, but it will take you into the workspace owner\'s account, with all their personal transfers, history and settings, and you will become the owner of %{teamName}.","bullet_workspace_intact":"The workspace, its members, subscription and billing are not affected.","bullets_intro":"If you accept and the workspace owner completes the ownership transfer:","data_access":"Before accepting, you can <a>request a copy of your data or delete it</a>. If you prefer not to proceed, no action is needed — simply close this page.","header":"Take over %{teamName}?","intro":"The workspace owner has asked you to take over ownership of %{teamName}.","tail":"The workspace owner still has to confirm to complete the ownership transfer after you accept.","warning":"<strong>This is an identity swap, not just a role change.</strong>"},"wrong_account":"This ownership transfer request was sent to a different account. Sign out and sign in with the account that received the link to review it."},"toasts":{"request_cancelled":"The ownership transfer request has been cancelled.","request_sent":"The ownership transfer request has been sent."}},"page":{"about":{"legal":{"actionbar":{"text":"Are you sure you want to clear your cookies?"}}},"about_plus":{"checklist":{"title":"Upgrade to Pro today for %{currency}%{price}/month"}},"account_payment":{"badge_text":"Active","billing_retry_badge_text":"Payment failed","billing_retry_info":"Reconfirm a valid payment method to restore your <b>%{plan}</b> features:","cancel_badge_text":"Cancelled","cancel_pill_text":"Cancelled","cancel_state":{"cancel_text":"Your workspace subscription has been cancelled and will end on %{cancellation_date}. Changed your mind? Don’t panic, it’s easy to get things back up and running.","reactivate_cta_text":"Reactivate"},"cta":"Compare all plans","free":"Free","manage_plan_button":"Manage plan","modal":{"bundle_included_summary":"You get access to your bundle at no extra cost.","bundle_plan_upgrade_info":"%{billing_interval} Ultimate + Bundle","bundle_upgrade_title":"Switch to Ultimate + Bundle","confirm_cta":"Co