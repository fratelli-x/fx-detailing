of Pro"},"sign_out":"Sign out","signed_in_as":"Signed in as %{name}","subscription_info":"Your Pro subscription of %{deal} will be renewed automatically on %{autorenewal_attempt}."},"advertise":{"gallery":{"preview":"Preview"},"guidelines":{"advert_static":{"title":"Static wallpaper"}}},"billinginfo":{"pagename":"Billing information"},"changepassword":{"pagename":"Change password"},"contact":{"action_bar":{"cancel":"Cancel","confirm":"Yes, delete","deselect_all":"Deselect all","select_all":"Select all"},"add_contact":"Add new contact","add_first_description":"We\'ll also save the email addresses you send files to here","add_new":"Add new","add_to_transfer":"Add to transfer","contact_count_one":"%{count} contact","contact_count_other":"%{count} contacts","create_contact_button":"Create contact","edit":"Edit","edit_contact":"Edit contact","edit_contact_button":"Edit contact","groups":{"add_contact":"Add contact","add_contact_modal_add":"Add","add_contact_modal_placeholder":"Search or enter email","add_contact_modal_title":"Add contact to group","add_new_group":"Add new group","add_to_transfer":"Add to transfer","back":"Back","contacts_count":"(%{count})","create_group":"Create group","create_group_name_placeholder":"Group name","delete":"Delete","delete_group_confirm":"Delete group","delete_group_menu":"Delete group","delete_group_modal_body":"This removes the group from your account. Contacts in this group stay in your full contacts list—they are not deleted from your contacts.","delete_group_modal_title":"Delete group?","group_already_exists":"A group with this name already exists","group_count_one":"%{count} group","group_count_other":"%{count} groups","group_options_aria":"Group options","no_groups":"No groups yet","no_groups_description":"Create a group to quickly add multiple recipients at once","remove_from_group":"Remove from group","rename":"Rename","rename_group_menu":"Rename group","rename_group_modal_title":"Rename group","search_contacts_placeholder":"Search by email, name or company","search_placeholder":"Search by name","tab_contacts":"Contacts list","tab_groups":"Groups of contacts"},"header_add_new_contact":"Add new contact","invalid_email":"Please enter a valid email address","no_contacts":"Add your first contact!","pagename":"Contacts","placeholder":{"company":"Company","email":"Email address","name":"Name"},"remove":"Delete","remove_from_transfer":"Remove from transfer","search_count_one":"%{count} search result","search_count_other":"%{count} search results","search_placeholder":"Search for email, name or company","select":"Select","selected_text_one":"%{count} contact selected","selected_text_other":"%{count} contacts selected"},"cookies":{"manage":{"button":"Open Cookie Settings","description":"Use the button below to manage your cookie preferences.","title":"Manage Cookie Preferences"}},"data_processing":{"prompt":{"cta_no":"No, thanks","cta_yes":"I agree","text":"With your permission, we’d like to access your transfer data to help us build the best WeTransfer experience. <a>Learn more</a>.","title":"Help us <span>improve</span> WeTransfer"},"settings":{"medical_consent":{"modal":{"dismiss_button":"Ok, thank you!","paragraph_1":"We ask you to confirm this because your transfers may include files that contain medical or health-related information (for example, .dcm or .dic files), which may qualify as health data under applicable data protection laws.","paragraph_2":"WeTransfer does not access or read the content of your files, and we do not process medical information as part of your file contents. However, since you may upload and share transfers that include health data, <strong>we need your explicit consent to process such data for the purpose of providing the file transfer service,</strong> and to ensure that you are authorized to share it, including where it relates to another person.","paragraph_3":"<strong>This option is disabled by default.</strong> The first time you upload files that may be considered health-related, we will explicitly ask you to provide your consent. We\'ll then remember your preference - and you can always review or change it in your settings.","paragraph_4":"Even if you have chosen to allow WeTransfer to use your transfer data for research purposes, this does not change how we handle health-related files: we still don’t read or inspect the file content, and you remain the owner and controller of the data in your transfer.","title":"About health-related data"},"read_more":"Read more about it","text":"Consent for WeTransfer to process any health data that may be included in your transfers solely for the purpose of providing the file transfer service.","title":"Health-related data"},"research_purpose":{"text":"Authorize WeTransfer to access and use your transfer data for research purposes.","title":"Research Purpose"},"title":"Data Processing"}},"delete_account":{"button":{"text":"Delete account"},"mfa_embedded_modal":{"body":"Because you have MFA enabled, you can only delete your account from the website to verify your identity.<0></0>Click the button below to be redirected to the web platform.","cancel_button":"Cancel","heading":"Delete account with multi-factor authentication from the website","login_button":"Log in to the web platform"},"mfa_modal":{"body":"We need to make sure it\'s really you who want to delete the account. Click the button below to verify your identity with MFA.","cancel_button":"Cancel","delete_button":"Verify and delete account","heading":"Verify identity with multi-factor authentication to delete account"},"modal":{"body":"Before you delete it, we want to ensure you are aware of this information. Do you confirm that you know that:","cancel_button":"Cancel","checkbox_label_1":"<strong>All your data</strong>, settings, and content will be <strong>permanently deleted</strong>","checkbox_label_2":"You will not be able to log in or create a new account with the same email for up to 7 days","checkbox_label_3":"Any active subscriptions will be <strong>canceled</strong> —for refunds visit the <0>Help Center</0>","checkbox_label_4":"Content in other WeTransfer products, like Collect, will also be deleted","checkbox_label_5":"The account deletion process is <strong>irreversible</strong>","delete_button":"I want to delete my account","heading":"You are permanently deleting your account"},"otp_modal":{"body":"We need to make sure it\'s really you who want to delete the account. Insert the code we sent to <0>%{email}</0>.","cancel_button":"Cancel","delete_button":"Delete account","errors":{"generic":"Something went wrong. Please try again.","invalid_otp":"The code is invalid or expired. Please try again."},"heading":"Insert verification code to delete account","placeholder":"Enter verification code","resend_button":"Resend code","resend_button_timer":"Resend code in %{timer}"},"text":"If you choose to delete your WeTransfer account, please know that all your data, settings, and content will be permanently lost. Content in other WeTransfer product, like Collect, will also be deleted. The deletion process may take up to 7 days, during which your account will be temporarily frozen. Once the process is completed, your account will be permanently deleted and we\'ll notify you via email. Please note that this action cannot be undone.","text_manage_subscription":"Just wanted to cancel your subscription? <a>Manage subscription</a>","title":"Account"},"document_ux":{"collapse":"Collapse document panel","expand":"Expand document panel","preview":{"page_of":"Page %{current} of %{total}","preview_unavailable":"Preview not available"}},"enterprise_landing":{"certs":{"ccpa_alt":"CCPA compliant","gdpr_alt":"GDPR compliant","iso_alt":"ISO 27001 Information Security Management certified","pci_alt":"PCI DSS compliant","title":"ISO 27001 certified. GDPR-compliant."},"controls":{"audit":{"desc":"Every upload, download, share and permission change: recorded, searchable and exportable.","status":"CSV export and SIEM logging","title":"Audit log"},"learn_more":"Learn more","security":{"desc":"Set the rules once, org-wide: 2FA, link expiry, external sharing and re-share policy.","status":"Company-wide transfer controls","title":"Centralised security settings"},"sso":{"desc":"One-click sign-in through your identity provider. Add SCIM to auto-provision and de-provision accounts.","status":"Compatible with all major IdP platforms","title":"SSO + SCIM"}},"faq":{"e2ee":{"answer":"Yes. We can enable end-to-end encryption for some or all transfers made by employees within your workspace, upon request.","question":"Does the Enterprise plan support end-to-end encryption?"},"min_users":{"answer":"Yes - a minimum of 50 users is required to purchase an Enterprise plan.","question":"Is there a minimum user count for the Enterprise plan?"},"payment":{"answer":"The standard payment method for the Enterprise plan is bank transfer, but we also support card payment.","question":"What payment methods are available for the Enterprise plan?"},"security":{"answer_lead":"You can find all of our security documentation, including our ISO 27001 certification, on our","answer_link":"Trust Center","question":"Where do I find WeTransfer\'s security and compliance documentation?"},"title":"Frequently asked questions"},"good_company":{"businesses":{"caption":"businesses use WeTransfer on a regular basis.","value":">2.5M"},"files":{"caption":"files are sent every month using WeTransfer.","value":">1.4B"},"fortune":{"caption":"of the Fortune 50 have a paid WeTransfer subscription.","value":">60%"},"title":"You’re in good company"},"hero":{"cta":"Get started","eyebrow":"WeTransfer for Enterprise","title":"The ultimate tool for external file sharing."},"intro":{"body":"WeTransfer Enterprise gives your employees unlimited transfers, with unlimited file size. It also gives you a range of tools to monitor and secure their usage.","eyebrow":"What is WeTransfer Enterprise","title":"The simplicity of WeTransfer. Enterprise-grade security."},"loved":{"col_capterra":"Capterra rating","col_g2":"G2 rating","col_limit":"File transfer limit","col_product":"Product","foot":"Sources: G2 and Capterra verified user reviews. Ratings are each platform\'s own aggregate score, as of 2 October 2026.","limit_box":"50 GB per upload","limit_dropbox":"100 GB per upload","limit_unlimited":"Unlimited","title":"Used and loved by millions of users every day."},"meta":{"description":"Fast, secure file transfer your employees already use. Audit logs, centralised security, SSO + SCIM, and ISO 27001 certification, without the SharePoint friction.","title":"WeTransfer for Enterprise"},"nav":{"cta":"Get started","help_center":"Support Articles","trust_center":"Security Documentation"}},"help":{"button_all_answers":"More answers","faq_0":{"desc":"We love feedback from our users, it helps us improve our service. Keep up-to-date with our new releases here.","title":"What’s new on WeTransfer?"},"faq_1":{"desc":"Want to know more about our suite of tools to keep your ideas moving? Check out this article which will give you the low down.","title":"Learn more about all of WeTransfer\'s products"},"faq_2":{"desc":"First things first, please check your spam/junk folder, it could happen that our emails end up in your spam folder. Not there? Don’t worry we have some tips that will help you out.","title":"I don\'t receive your emails"},"faq_3":{"desc":"We pride ourselves on our free service but have you seen what WeTransfer Pro and WeTransfer Premium offers? Make sure you aren\'t missing out on anything!","title":"What does a WeTransfer subscription offer me?"},"faq_4":{"desc":"You asked, we provided. Introducing WeTransfer Accounts, they are 100% free with extra features. It’s a win win situation.","title":"Introducing free WeTransfer accounts"},"faq_5":{"desc":"Our main priority is keeping your account secure, which is why we are consistently working on ensuring the security of our platform as it evolves.","title":"Why am I being asked to verify my WeTransfer account?"},"faq_6":{"desc":"Accidentally uploaded the secret nuclear launch codes? Happens to the best of us! But don’t panic, there’s still hope.","title":"Can I delete my upload?"},"faq_7":{"desc":"To access your WeTransfer account, please click the \'Log in\' top right corner. Enter in your details and you’ll be on your way in no time.","title":"First things first: here\'s how to log in"},"page_title":"Quick Help","read_more":"Read more","search_button":"Search","search_placeholder":"What can we help you with?"},"image_gallery":{"collapse":"Collapse gallery","expand":"Expand gallery"},"image_gallery_toggles":{"allow_comments":"Allow comments","tooltip_comments":"Receivers will be able to add comments while previewing your transfer","tooltip_watermark":"Protect your content with a watermark","watermark":"Watermark"},"integrations":{"title":"Integrations"},"invoices":{"pagename":"Receipts"},"landing_page_template":{"cta_footer":{"cta":"Get started","title":"Start sharing your ideas"},"differentiators":{"cta":"Unlock WeTransfer Ultimate • 7-day free trial","cta_albums":"Create your first WeTransfer album","subtitle":"Our features are designed to minimize how much of your data we — or anyone else — can access, so you can keep what\'s yours, yours.","tiles":{"enterprises_caption":"43K+ Enterprises using WeTransfer daily","enterprises_value":"43k","rating_caption":"4.8 App Store / Play Store average rating","rating_value":"4.8","transfers_caption":"30M+ Transfers sent every month","transfers_value":"30M","users_caption":"12M+ Monthly active users","users_value":"12M"},"title":"What makes WeTransfer different"},"enterprise_banner":{"cta":"Click here to learn more about WeTransfer Enterprise","question":"Looking for 50+ users?"},"faq":{"subtitle":"All your questions answered.","title":"FAQs"},"features":{"albums":{"people_description":"Invite as many or as few people as you want. Everyone contributes, everything stays in one place.","people_title":"All the people you want","resolution_description":"Every photo lands exactly as it was taken. No compression, no quality loss.","resolution_title":"Full resolution photos, no compromise","sharing_description":"One link brings everyone together. Anyone can add photos.","sharing_title":"Shared group photo collection"},"default":{"collaboration_description":"With tools designed to enhance collaboration, get everyone in your team talking and moving as one, without disrupting their workflow.","collaboration_title":"Collaboration tools for teams of all sizes","file_sharing_description":"Share content with a unique link, give anyone a free pass to send you 200 GB files, and stay in control of transfers — even after you hit send.","file_sharing_title":"Move your ideas forward","security_description":"From password protection to file encryption, WeTransfer has all the built-in security features you need to safeguard your work.","security_title":"Share with confidence and security"},"subtitle":"Give people simple tools, and they\'ll do extraordinary things. Ultra-fast file transfers, built-in customization, easier team collaboration. That\'s the magic of WeTransfer.","subtitle_albums":"Create a shared album in seconds, invite anyone, and collect everyone\'s photos in full resolution — no hassle.","title":"Everything you need"},"hero":{"albums_start":{"cta":"Create your first WeTransfer album","start":"Start here","subtitle":"The easiest way to collect, organize, and share pictures","title":"Create your first album"},"breadcrumbs":{"home":"Home","resources":"Resources"},"dropzone":{"browse":"or click to browse","cta":"Send your first transfer","label":"Drag & drop to start transferring","label_albums":"Drag & drop to start your first album","label_mobile":"Tap to start transferring"},"explore":"Explore WeTransfer","explore_albums":"Explore WeTransfer Albums"},"intro":{"caption":{"albums":"Collect and share group photos in one place","branded-file-tr