ner_title":"%{productCount} premium subscriptions","free_of_charge":"Free of charge","subtitle":"Did you know you have complimentary access to products such as %{products} when you stay with WeTransfer?","subtitle_secondary":"If you terminate your subscription, access to these products will end at the end of your billing period.","title":"Before you go: you have %{productCount} more products"},"tooltip":"One subscription that includes WeTransfer, Vimeo, Evernote, Meetup and many more Bending Spoons products."},"cancel_subscription":"Cancel subscription","cancelling":"Cancelling...","compliance":{"modal":{"benefits_starter":{"benefit_1":"Share and receive up to 300 GB per month","text":"From %{renewal_date} your plan will expire and you\'ll lose access to all these benefits:"},"benefits_ultimate":{"benefit_1":"Share and receive unlimited files","benefit_2":"Unlimited transfers per month","benefit_3":"Transfer expiry up to 1 year","benefit_4":"Custom branding per transfer","benefit_5":"Automatic malware scan","more":"... and many more.","text":"From %{renewal_date} your plan will expire and you\'ll lose access to all these benefits:"},"buttons":{"cancel_plan":"Cancel and lose benefits","keep_my_plan":"Keep my plan"},"title":"Are you sure you want to cancel?"},"offer":{"billing":{"monthly":"Monthly","weekly":"Weekly","yearly":"Yearly"},"description":"Stay with us and enjoy %{discount}% off.","footer":{"button":"Get the offer!","renewal_date":"Your new plan will renew on %{date}"},"pricing":{"discount":"%{discount}% discount on the next renewal","monthly":"%{billing_period} %{plan_tier} plan","new_price":"Your new price on %{date}"},"savings":"Save %{amount} and keep all %{plan_tier} benefits","title":"Wait, there\'s something for you!"},"page":{"back_to_manage":"Back to manage plan","benefits_starter":{"benefit_1":{"description":"Higher limits on how much you can send and receive","title":"Share and receive up to 300 GB per month"}},"benefits_ultimate":{"benefit_1":{"description":"No limits on GB you can send and receive","title":"Share and receive limitless"},"benefit_2":{"description":"No worries about how many files you share","title":"Unlimited transfers per month"},"benefit_3":{"description":"Don\'t worry about expiration dates","title":"Transfer expiry up to 1 year"},"benefit_4":{"description":"Let your transfers speak for you","title":"Branded transfers and emails"},"benefit_5":{"description":"Never be afraid of losing your files","title":"Recover expired transfers"},"benefit_6":{"description":"Download files without worrying","title":"Automatic malware scan"}},"buttons":{"cancel_plan":"Cancel and lose benefits","keep_my_plan":"Keep my plan active"},"subtitle":"From %{renewal_date} your plan will expire and you\'ll lose access to all these benefits:","title":"Are you sure you want to cancel your subscription?"}},"downgrade_banner":{"cta":"Contact support","text":"Currently, downgrading your plan to a different subscription is not possible. However, you can cancel your subscription and continue to use it until the end of your current billing period. Once the period ends, you can choose to re-subscribe to a lower-tier plan.","title":"Keep your WeTransfer account and downgrade?"},"drawbacks":{"cancel_plan":"If you cancel your subscription now, when the cycle ends on %{renewal_date}:","cancel_plan_compliant":"If you cancel your subscription now, when the cycle ends on %{renewal_date} <strong>all your existing transfers will be deleted after 28 days</strong>.","cancel_plan_text":"<li><strong>All your existing transfers will be deleted after 28 days</strong></li><li>Your new transfers will last no more than 7 days</li><li>You\'ll lose your branded url and background</li><li>You won\'t be able to send more than 10 transfers every 30 days</li>","confirmation_error":"You need to confirm that you read and understood the disclaimer above.","confirmation_subtitle":"I accept that by cancelling my %{plan_tier} subscription I will lose my saved transfers and %{plan_tier} benefits.","confirmation_subtitle_compliant":"I accept that by cancelling my %{plan_tier} subscription I will lose my saved transfers.","confirmation_title":"I am sure I want to lose my transfers and benefits","confirmation_title_compliant":"I am sure I want to lose my transfers"},"modal":{"discount":"%{discount}% discounts on the next renewal","discount_title":"Don’t miss this special offer!","get_offer":"Get the offer!","goodbye":{"button":"Decline offer and cancel subscription","button_compliant":"Cancel my subscription","text":"We understand, but we\'d love to see you again. If you ever need WeTransfer, your files and creativity will always be welcome here!","title":"Hope to see you back soon!"},"new_price":"Your new price on %{date}","pause":{"button":"Pause subscription","description":"You can pause your subscription for 2 weeks and resume anytime while keeping all your unlimited benefits.","feature_1":"You won\'t be charged during the break","feature_2":"Access your files and downloads","feature_3":"Resume anytime, no limits on transfers!","title":"Would you like to take a break?"},"plan":"%{billing} %{plan_tier} plan","renewal_date":"Your new plan will renew on %{date}","save_text":"Save %{amount} and keep all %{plan_tier} benefits","scroll_hint":"More options","stay":"Stay with us and enjoy %{discount}% off!","support":{"button":"Contact Support","text":"We\'re here to help. Let\'s make sure WeTransfer works just the way you need it. Chat with our team and get support!","title":"Facing any issues? Let\'s fix them!"},"terms":"By updating your subscription, you agree to our <0>Terms of Service</0>","title":"Leaving already?"},"receiver":{"buttons":{"cancel_and_lose_transfers":"Cancel and lose transfers","keep_plan":"Keep plan"},"confirm_checkbox":"I accept that by cancelling my Ultimate subscription I will lose my saved transfers.","expired_label":"Expired","subtitle":"If you cancel your plan, you\'ll lose the ability to recover expired transfers you received.","title":"You won\'t be able to access expired transfers you received"},"sender":{"expired_recovery":{"subtitle":"If you cancel your plan, you\'ll lose the ability to recover your expired transfers.","title":"You won\'t be able to recover your expired transfers."},"transfers_at_risk":{"subtitle":"If you cancel your subscription now, when the cycle ends on %{renewal_date} all your existing transfers will be deleted after 28 days.","title":"Are you sure you want to cancel your subscription?"}}},"change_plan":"Change plan","current_solo_workspace_information":"Your current %{plan_tier} plan of <strong>%{total}</strong>/%{interval} will automatically renew on <strong>%{renewal_date}</strong>. See <pricingPageLink>plan details.</pricingPageLink>","current_solo_workspace_information_price_increase":"Your current %{plan_tier} plan will automatically renew on <strong>%{renewal_date}</strong> for <strong>%{total}</strong>/%{interval}. See <pricingPageLink>plan details.</pricingPageLink>","current_team_workspace_information":"Your current %{plan_tier} plan of <strong>%{workspace_total}</strong>/%{interval} (%{member_count} members x %{tier_amount}) will automatically renew on <strong>%{renewal_date}</strong>. See <pricingPageLink>plan details.</pricingPageLink>","cycle_upgrade":"Change subscription cycle","cycle_upgrade_subtext":"You can only switch to a billing cycle based on your current subscription. The new subscription will start automatically and you’ll be credited the difference. You can upgrade your billing cycle at anytime.","downgrade":{"current_solo_workspace_information":"Your current plan will automatically be downgraded on %{renewal_date}","current_team_workspace_information":"Your current plan will automatically be downgraded on %{renewal_date}"},"monthly":"Monthly","monthly_billing_frequency":"Billed every month","monthly_price":"%{price}<billingIntervalLabel>/month</billingIntervalLabel>","pagename":"Manage plan","save_percentage":"Save %{percentage}%","upgrade_button":"Upgrade","upgrade_text":"You can upgrade to a higher subscription anytime. The new subscription will start today, and you’ll be credited the difference.","yearly":"Yearly","yearly_billing_frequency":"Billed every year","yearly_price":"%{price}/year"},"medical_consent":{"cta_no":"No, I do not consent","cta_yes":"Yes, I consent","expiry_tooltip":"Transfers that may contain medical information automatically expire after a maximum of 60 days.","recoverability_tooltip":"Transfers that may contain medical information can\'t be made recoverable.","sentence_1":"By choosing “Yes, I consent”, you consent to WeTransfer processing health data included in this transfer solely to provide the file transfer service.","sentence_2":"Transfers containing this type of content are non-recoverable and expire after a maximum of 60 days.","sentence_3":"WeTransfer does not access, analyze, share, or use your files for any other purpose. Your data is not used for profiling, advertising, or product improvement, and is handled only to deliver the transfer.","sentence_4":"You confirm that you have the necessary rights and permissions to share this data, including where it relates to a third party. You can withdraw consent at any time in your account settings.","sentence_5":"Learn more in our <privacyPolicyLink>Privacy Policy</privacyPolicyLink> and our <contentProtectionLink>Principles of Content Protection</contentProtectionLink>.","title":"Looks like this transfer could include medical information, which may qualify as health data under data protection laws","transfer_tooltip":"Transfers that may contain medical information can\'t be made recoverable and automatically expire after a maximum of 60 days. Learn more <a>here</a>."},"not_found":{"body":"Head back to <a href=\\"https://wetransfer.com/\\">wetransfer.com</a> or cheer up your eyes with some <a href=\\"https://wepresent.wetransfer.com/\\">nice things we wrote</a>.","image_alt":"Something went wrong","title":"Yikes, that page can’t be found."},"options_page":{"done":"Done"},"password_and_security":{"link_preview_thumbnails":{"description":"Get a thumbnail containing a preview of your image, video or document when sharing a transfer link on supported platforms. This only applies to public transfers.","title":"Allow preview thumbnails on shared links"},"logout_all":{"button":"Log out","description":"Log out from all devices currently signed in with your account.","modal":{"cancel":"Cancel","confirm":"Log out everywhere","message":"This will sign you out of WeTransfer on every device where you\'re logged in as %{email}.","title":"Are you sure you want to log out from all devices?"},"title":"Log out of all devices"},"title":"Password and security","two-factor-authentication":{"description":{"enabled":"Since %{date}"},"disable":"Turn off","done":"Done","enable":"Turn on","get_recovery_codes":"Get recovery codes","next_step":"Next","recovery_code_action":"Generate new codes","recovery_code_keep_safe":"Each code can only be used once, but you can always get more if you need them.","recovery_code_need_more":"Need more recovery codes? You can always generate new ones, just keep in mind that this will make all the current codes invalid.","recovery_code_title":"Your recovery codes","require_password_action":"Enter","require_password_text":"Enter your password to continue","step_one_action":{"app_store":"Download on App Store","google_play":"Get it on Google Play"},"step_one_label":"Step 1 (of 3)","step_one_text":"You will need an authenticator app on your phone. If you already have Google Authenticator (or a different app), click next.","step_one_title":"Download Google Authenticator","step_three_label":"Step 3 (you’re all set!)","step_three_text":"If you need to log in and don’t have your phone with you (we hear that it does happen), you can use one of these recovery codes. We won’t save these codes for you or show them to you again, so grab them now—and be sure to keep them as safe as the passcode to your bank account.","step_three_text_2":"Keep these codes as safe as your password to your bank account! Each code can only be used once.","step_three_title":"Save recovery codes","step_two_form":{"error":"Uh-oh, that code is wrong or expired","label":"Verification code"},"step_two_label":"Step 2 (halfway there)","step_two_text":"Use your authenticator app to scan this barcode. The app will generate a six-digit verification code; enter that code below.","step_two_text_mobile":"Enter this key in your authenticator app. The app will generate a six-digit verification code; enter that code below.","step_two_title":"Scan barcode","step_two_title_mobile":"Enter key","text":{"protect_account":"Use your phone to add an extra layer of security to your account."},"title":"Two-factor authentication"}},"payment":{"cancel":{"confirm":"Are you sure you want to cancel your subscription?"},"download_invoice":"Download invoice","manage":{"actions":{"default":"Default","delete":"Delete","expired":"Expired","make_default":"Make default"},"add_payment_method":"Add payment method","card":{"expiration":"Expires %{month}/%{year}"},"ideal":{"type":"Bank Transfer"},"paypal":{"type":"PayPal"},"title":"Payment Methods"},"mobile_subscription":{"content":"To view or manage your subscription, log in to your %{app_name} account from your phone or computer.","go_to":"Go to","learn_more":"Learn more","title":"You\'re subscribed from the %{app_name}"},"pagename":"Plan and payment","reactivate":{"confirm":"Yes, go ahead","confirm_reactivate_subscription":"Excellent choice! Just one more click to reactivate your payment method","updating":"Updating..."},"setup_card":{"confirmation":{"body":"Your payment details have been saved. Your account manager will take it from here.","title":"Payment details added successfully"},"submit":"Add payment details","submitting":"Submitting...","subtitle":"Add your payment details below. Your account manager will then be able to activate your Enterprise plan.","title":"Add Payment Details","vat_tooltip":"We only require your VAT ID if you are based in the EU. If you are based in Italy or the Netherlands, you will be charged VAT. If you are based elsewhere in the EU, you will not be charged VAT."},"update":{"confirmation":{"body1":"New and pending invoices will be charged to this updated payment method. Please note that, depending on the type of payment method, processing may take some time.","body2":"Please check your account page to see the status of your invoices.","go_to_account":"Go to your account","title":"Your new payment method has been set up"},"de_legislation_text":"Ich fordere und stimme ausdrücklich zu, dass Sie mit der von mir bestellten Dienstleistung vor Ablauf der Widerrufsfrist beginnen. Mir ist bekannt, dass mein Widerrufsrecht mit vollständiger Vertragserfüllung erlischt.","submit":"Submit","submitting":"Submitting...","title":"Update Payment Method"},"upgrade_cta":"Upgrade"},"payment_cancel":{"cancel":"Go back","info":"Tell us your reason for leaving and we’ll continue to improve WeTransfer Pro with you in mind.","info_with_end_date":"<p>You’ve now cancelled your subscription and you’ll be downgraded to a free WeTransfer account after <b>%{ends_at}.</b></p>\\n<p>Please tell us your reason for leaving so we can improve WeTransfer with you in mind.</p>","pagename":"Before you go","reason_header":"We’re sad to see you go","yes_disable":"Yes, go ahead"},"payment_methods":{"do_not_refresh":"Try and resist the temptation to refresh or close this page","payment_in_progress":"Processing your payment..."},"pricing":{"pro":{"per_person":"per person"}},"pricing_panel":{"cta":{"create_account":"Create account","current_plan":"Current plan","sign_up":"Sign up","switch_premium":"Switch to Premium","switch_pro":"Switch to Pro","upgrade":"Upgrade"},"faq":{"answers":{"answer_1":"You’ll be able to get started with your WeTransfer subscription as soon as you’ve completed your payment. We’ll also send you a confirmation email with your paid invoice attached. <br /><br />\\n\\nOnce you’re in, you’ll be able to enjoy your subscriber benefits right away. If you have any previous transfers that were sent while you were on the free plan, you’ll also be able to change the expiration dates to whenever you like.","answer_2":"When you use WeTransfer, anyone can download your files—there’s no need for them to log in or sign up. They’ll have to accept our Terms of Service and we may ask them to accept cookies, but that’s it!","answer_3":"With an Ultimate plan, you can create your own WeTransfer page where anyone can send you countless files, benefitting from the unlimited power of the Ultimate plan. That means you can get the large files you need from clients or collaborators, and they won\'t need to have an account—just the URL to your page. (Though we may ask them to verify their email address to protect you from \\"foreign princes\\" who \\"want to send you money\\").","answer_4":"First, you’ll need to sign up for WeTransfer Teams—you can’t add team members while you’re on the free, Starter or Ultimate plan. Your team members will get access to your same plan and benefits. Team members will be able to send and receive transfers from your WeTransfer page, and manage transfers from one shared overview. <br /><br />\\n\\nOnce you’ve signed up for the Teams plan, you’ll be able to invite as many team members as you like from your team management settings. You can add and remove members from your team at any time while your subscription is active.","answer_5":"We accept PayPal as well as credit cards by major networks such as Visa, Mastercard, and American Express. We also support other online payment systems in some countries. <br /><br />\\n\\nWe don’t accept direct bank transfers because you have to sign up for a recurring subscription.","answer_6":"By default, your account can store up to 2TB, regardless of the plan you’re on. If you hit your limit you can  clear up some storage by deleting a selection of your sent or received transfers. Until you do, you won’t be able to send or receive new transfers. <br /><br />\\n\\nIf you need a storage extension, you can contact our team. We’ll do our best to accommodate your request, but keep in mind that we don’t offer unlimited storage.","answer_7":"The Free plan is perfect for personal, non-commercial use. You can send and share files with anyone via email or a download link. It’s great for sending photos, documents, or small creative projects to friends or collaborators.\\n\\nHowever, please note that the Free plan is intended strictly for non-commercial purposes. If you’re using WeTransfer for business or professional work, we recommend upgrading to one of our paid plans, which are designed to support commercial use and offer additional features like larger transfers, storage, and branding options.","answer_8":"WeTransfer subscriptions are set to renew automatically. However, you can cancel any time from your <strong>Account</strong> Settings. <br /><br />\\n\\nOnce you’ve cancelled your subscription, you (and any team members you might have on the account) will be able to continue enjoying your plan until the end of your current subscription period. After that, your account will revert to WeTransfer Free.","answer_9":"Millions of people around the world trust WeTransfer and our set of tools to share their ideas—with more than 2 billion files sent through our platform every month. <br /><br />\\n\\nTo keep your ideas safe from attack or exploitation, your files are encrypted when they are transferred (TLS) and when they are stored (AES-256). Once your files are stored, they can only be accessed using the unique links sent to the sender and recipient."},"questions":{"question_1":"What happens after I sign up and pay?","question_2":"Do my recipients need to sign up?","question_3":"Can I receive bigger transfers from anyone?","question_4":"How do I add (and remove) team members?","question_5":"What payment methods can I use?","question_6":"What happens if I go over my storage limit?","question_7":"What can I do with a Free plan?","question_8":"How do I cancel?","question_9":"Can I trust WeTransfer? How safe is it?"}},"feature_table":{"branding":{"features":{"advertising":"Advertising (and art)","custom":"Upload your own","feature_1":"Custom WeTransfer page","feature_2":"Wallpaper backgrounds","feature_3":"Personalized WeTransfer emails","feature_4":"Custom transfer wallpapers"},"title":"Show off your brand"},"doing_good":{"features":{"feature_1":"Your actions help worthwhile causes and talented creatives worldwide","feature_2":"Your subscription helps support sustainable projects worldwide","feature_3":"Your subscription contributes to grants for emerging creatives"},"title":"Good for people and planet"},"expiry":"Transfers expire after %{days} days","extra_storage":"Extra %{storageLimit} per person","security":{"features":{"feature_1":"Custom expiration dates","feature_2":"Password-protected transfers","feature_3":"Data encryption","feature_4":"Two-factor authentication"},"title":"Secure your transfers"},"storage_limit":"%{storageLimit} per person","teams":{"features":{"feature_1":"Invite team members","feature_2":"Shared transfer overview","feature_3":"Shared storage","feature_4":"Shared branding","requires_enterprise":"Requires Teams"},"subtext":{"learn_more":"Learn more","text":"Only supported if you purchase a subscription from our website."},"title":"Deliver work as a team"},"transfer_classic":{"features":{"feature_6":"Request and receive files"},"title":"Send and receive big files"},"unlimited":"Unlimited"},"header":{"subtitle":"Whether you’re sending big files for fun or delivering work for clients—keep creative projects moving forward with WeTransfer.","title":{"english_1":"You’ve got the ideas,","english_2":"we’ve got the plans","general":"Plans & pricing"}},"month":"month","plans":{"banner_text":"Save %{discount_amount} / month by <span>paying yearly</span>","billing":{"discount":"Save %{percentage} (ooh yeah)","discount_up_to":"Save up to %{percentage} (ooh yeah)","discount_up_to_short":"Save up to %{percentage}"},"free":{"subtitle":"Send files once in a while","title":"Free","usp":{"feature_1":"Send up to %{transferLimit}","feature_1_alt":"Send up to %{transfer_count_limit_30_days} transfers or %{transfer_size_limit_30_days} per month","feature_2":"No need to verify transfers","feature_4":"Up to 20 downloads per transfer"}},"premium":{"subtitle":"Share work with no limits","title":"Premium","usp":{"feature_1":"No size limit on transfers","feature_2":"Unlimited storage","feature_2_subtitle":"*Initially %{storageLimit} storage. Need more? <a href=\'%{href}\' rel=\'noopener noreferrer\' target=\'_blank\'>Contact us.</a>","feature_4":"Unlimited downloads per transfer"}},"pro":{"subtitle":"Send really big files regularly","title":"Pro","usp":{"feature_1":"Send and receive up to %{transferLimit}","feature_2":"%{storageLimit} storage per person","feature_4":"Unlimited downloads per transfer"}},"title":"Choose your plan"},"skip_link":"Jump to more features","week":"week"},"product_bundle":{"card":{"airtable_tooltip":"Connected data and team workflows.","aol_title":"AOL Protection Bundle","aol_tooltip":"Identity protection and data security.","code_error":"We couldn\'t get your code. Please try again.","evernote_title":"Evernote Advanced","evernote_tooltip":"Notes, tasks and schedule in one place.","harvest_title":"Harvest Teams","harvest_tooltip":"Time tracking, invoicing and reporting.","issuu_title":"Issuu Unlimited","issuu_tooltip":"Digital publishing and flipbooks.","komoot_title":"Komoot Premium","komoot_tooltip":"Outdoor route planning and navigation.","meetup_tooltip":"Find and organize interest-based events.","mileiq_tooltip":"Automatic mileage tracking and reporting.","redemption_access":"With WeTransfer Ultimate you have full access to %{product}.","remini_tooltip":"AI-powered photo enhancement.","splice_tooltip":"Mobile video editing and creation.","streamyard_title":"Streamyard Advanced","streamyard_tooltip":"A browser live-broadcast and recording studio.","subscription_title":"%{product} subscription","tractive_tooltip":"GPS pet location and health tracking.","upgrade_to_redeem":"Upgrade to redeem","vimeo_title":"Vimeo Standard","vimeo_tooltip":"Video hosting and streaming."},"entitlement":{"description_with_remaining":"%{featuredProductList} and %{remainingProductCount} more, all included. Redeem them whenever you\'re ready.","description_without_remaining":"%{featuredProductList}, all included. Redeem them whenever you\'re ready.","title":"Your plan gives you access to %{appCount} other apps"},"faq":{"a1":"Everything you can redeem with your plan is listed on your bundle page. Open a product from there and your code will be applied automatically. For most products you\'ll create an account or sign in, then complete a $0 checkout to activate it. Each code can be used once, on one account.","a2":"No. These products are provided as part of your current plan.","a3":"For each promotional code you redeem, your access to the corresponding bundled product will continue for the same duration as your current WeTransfer subscription. We\'ll let you know before your next renewal whether the Bundle Promotion will continue to be available. See the <terms>Bundle Promotion Condition</terms> for details.","a4":"Your promotional, premium access to each product is linked to your WeTransfer subscription. If your WeTransfer subscription ends, any promotional access you’re eligible for will also end, and you\'ll revert to the free version of each product, where available.","a5":"Each code works on one product only and can be used once, so it\'s worth checking you\'re using the right one and that it hasn\'t already been redeemed. A few of the products also aren\'t available in every country. If it still doesn\'t work, contact support with the code and we\'ll look into it.","a6":"Some products ask for payment details as part of their normal sign-up and checkout. So long as your redeem code is applied, your card will not be charged.","a7":"Codes can\'t be applied to a paid subscription you\'re already using.","q1":"How do I redeem my bundle benefits?","q2":"Do I have to pay anything extra?","q3":"How long do I have access?","q4":"What happens if I unsuscribe?","q5":"My redeem code is not working.","q6":"Why do I need to enter payment details to redeem my subscription?","q7":"I already pay for one of these prodcuts. Can I still redeem my code?","subtitle":"Quick answers on redeeming your codes and setting up each app.","title":"Frequently asked questions"},"pagename":"Product bundle","redeem_modal":{"code_copied":"Code copied","code_description":"Redeem to reveal your code, then enter it at checkout.","code_title":"Your %{product} code","copy_code":"Copy code","direct_link":{"code_description":"Redeem to reveal your code, then enter it in the dedicated page.","steps":{"redeem":"Click on <strong>Redeem</strong> to navigate to the redemption page.","use_code":"Paste your code, or use the one already filled in."}},"harvest":{"code_description":"Copy this code, then enter it in Harvest.","steps":{"apply_code":"At the payment step, click “Apply a promotion code” and enter your code. Then, add a payment method and confirm.","close_subscription":"Complete the quick setup. When the subscription screen pops up, close it without subscribing (just click the “X”).","open_billing":"Go to Settings > Billing > Upgrade now.","select_plan":"Select the Teams plan with yearly billing and set the desired number of seats. Up to 10 seats will amount to %{amount}.","signup":"Create your Harvest account at <signupLink>this signup link</signupLink>."}},"mileiq":{"code_description":"Redeem to reveal your code, then enter it in the App Store.","steps":{"guide":"Having trouble? Follow the <guideLink>App Store gift code redemption guide</guideLink>.","redeem":"Click on <strong>Redeem</strong> to open the App Store with your code already filled in."}},"secret_menu":{"code_description":"Copy this code, then enter it in %{app} on %{platform}.","get_app":"Get %{app} for %{platform}","steps":{"enter_code_description":"Copy your code below, paste it into the dedicated field, then tap <strong>Redeem</strong>.","enter_code_title":"Enter your code in the app","install_description":"Download it from your app store, then open it.","install_title":"Install and open %{app}","menu_description_android":"On the home screen, touch and hold with four fingers to open the menu.","menu_description_ios":"On the home screen, touch and hold with three fingers to open the menu.","menu_title_android":"Hold four fingers on the screen","menu_title_ios":"Hold three fingers on the screen","platform_description":"Select iOS or Android to get the right app download link.","platform_title":"Choose your platform","redeem_description":"Choose this option from the menu that appears.","redeem_title":"Tap ‘Redeem Gift Code’"},"subtitle":"Follow these steps on your phone, then use the code below to activate your plan.","title":"Activate your %{app} subscription"},"steps":{"account":"Create a new %{product} account, or log in to your existing one.","activated":"Your plan is activated!","payment":"Enter your payment details and complete checkout: you won\'t be charged for your subscription.","redeem":"Click on <strong>Redeem</strong> to navigate to the checkout page.","use_code":"Paste your code, or use the one already filled in. This ensures your new subscription costs %{amount}."},"streamyard":{"code_description":"Redeem to continue to StreamYard: your reward is applied automatically.","code_title":"Your %{product} reward","steps":{"start_subscription":"Redeem your reward to start your subscription."}},"title":"How to redeem your %{product} subscription:"},"upgrade_hero":{"monthly_price_suffix":"per month","offer-terms":"Offer subject to <0>conditions</0>.","offer-terms-link":"conditions","paid_title":"Do more with the Ultimate Bundle offer","restart-subscription":{"cta":"Restart subscription","description":"Restart your subscription to keep access to the Bundle and its premium apps.","legal":"By clicking on <strong>%{cta}</strong>, you’re restarting an <strong>auto-renewing subscription</strong>. Your exact renewal terms, including price and billing date, will be shown before confirmation. You can downgrade or cancel any time in your account settings."},"title":"Do more with the Ultimate Bundle","upgrade-bundle":{"complimentary_description":"Upgrade to Ultimate Bundle to access and redeem a curated set of creative and productivity tools. By redeeming your first product, you accept our <0>Bundle Promotion Terms and Conditions</0>.","cta":"Add Bundle to plan","description":"Upgrade to Ultimate Bundle to access and redeem a curated set of creative and productivity tools.","legal":"By completing this purchase, you’re activating the <strong>Product Bundle offer</strong> as an eligible Ultimate subscriber. Starting on <strong>%{renewalDate}</strong>, you’ll be charged <strong>%{renewalPrice}/%{billingPeriod}</strong> for the Ultimate Plan unless you cancel or downgrade at least 1 day before renewal. You can downgrade or cancel anytime through account settings. By proceeding, you accept the <termsLink>Bundle Promotion Terms & Conditions</termsLink>."},"upgrade-ultimate":{"cta":"Upgrade to Ultimate + Bundle","description":"Upgrade to Ultimate Bundle to access and redeem a curated set of creative and productivity tools."},"value_banner":"Up to $2,200 in value"}},"profile":{"branding":{"headline":"<strong>Send the best.</strong> Make a great impression every time people download your files.<br /> <strong>Receive with ease.</strong> Anyone can upload files to you as part of your plan.","protip":{"link":"Learn more","text":"<strong>Pro tip:</strong> Requesting a transfer from someone? Share a special link to pre-fill the description for them."}},"choose_wallpapers":"Add your wallpapers","description":{"premium":"Your WeTransfer page lets you make a great impression every time people download your files. This is also where anyone can send you transfers with no file size limits, as part of your WeTransfer Premium plan.","pro":"Your WeTransfer page lets you make a great impression every time people download your files. This is also where anyone can send you 200 GB transfers, as part of your WeTransfer Pro plan."},"instructions-1":"Change your name and URL as many times as you need.","instructions-2":"Once you’ve chosen a new URL, your page will be updated right away.","onboarding-step-two":"Present your files in style, personalize your WeTransfer page and admire your new look at <subdomainLink>%{subdomain}</subdomainLink>","pagename":"Branding","profile_url":"URL","receiving":"Profile email","step-one-banner":"To get started, choose a URL for your WeTransfer page. You can always change this later.","title":"Edit your page","upsell":{"benefit_one":"Get your own WeTransfer domain","benefit_one_alt":"Get your own WeTransfer page","benefit_three":"Design your transfer emails","benefit_two":"Show custom wallpapers when people download your files","button":{"action":"Tell me more"},"heading":"Show off your brand with WeTransfer Pro","heading_alt":"Deliver your work in style"},"wallpapers":{"best_1":"Up to five different images","best_2":"JPEG or PNG","best_3":"Up to %{size}","best_4":"%{resolution} pixels or more","best_5":"No GIFs or videos (sorry)","best_five":"%{videoResolution} pixels for videos","best_four":"%{resolution} pixels for images","best_one":"Up to five videos or images","best_six":"Image wallpapers rotate every %{rotationInterval} secs, videos longer than %{rotationInterval} secs will be cut short","best_three":"%{size} max per video/image","best_title":"The important bits:","best_two":"JPEG, PNG or MP4","notice":"Drumroll please — video wallpapers have landed! <a>Make your background a video now</a>.","text":"Put yourself or your brand front and center with up to five rotating videos or images:"}},"renewbilling":{"pagename":"Review your information and renew"},"reviewbilling":{"information":"In order to change your payment method, we’ll need to renew your subscription at the same time","information_payment":"You will be charged %{deal} for the next %{period} of Pro – your subscription will be good until %{expiry}","pagename":"Confirm your payment details"},"subscriber_benefits":{"description":"Get exclusive discounts and offers from our partners. Stay inspired and keep more money in your pocket.","footnote":"See <tcLink>here</tcLink> for the WeTransfer Subscriber Benefits Program Terms & Conditions. Our partners may apply additional terms for their offer. Please see their websites for more information.","icon_alt_text":"%{offer} icon","offers":{"adobe_premiere":{"description":"Now get one month of %{plan} on us and tell your stories in professional videos.","title":"One month trial of %{plan}"},"mubi":{"description":"Stream beautifully-curated cinema on %{mubi} for 90 days free.","title":"90 days free on %{mubi}"},"premium_beat":{"description":"Get 25% off the internet’s premier audio library. Music to your ears. Save 25% on all %{premiumBeat} tracks.","title":"Save 25% on %{premiumBeat} tracks"},"shutterstock":{"description":"The world’s best asset library, right at your fingertips. Save 25% off all %{shutterstock} assets.","title":"25% off %{shutterstock}"},"skillshare":{"description":"Unlock one month free access to learning content. Plus, an additional 30% off when you sign up.","title":"Get 30% off and one month free on %{skillshare}"},"soundcloud":{"description":"Realize your artistic potential with %{soundcloud}’s best-in-class artist tools and services, now with three months free.","title":"Three months free of %{plan}"},"veed":{"description":"Get 25% off AI-powered video editing with %{veed}.","title":"25% off AI-powered video 