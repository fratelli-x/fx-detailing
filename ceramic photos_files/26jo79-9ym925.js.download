 to verify your email.","verification_failed":"Invalid verification code. Please try again.","verify":"Verify","verify_and_send":"Verify and Send","verify_and_send_disclaimer":"By selecting Verify and send, you accept our <wtTermsLink>Terms of Service</wtTermsLink>, including <signTermsLink>WeTransfer Sign Additional Terms of Service</signTermsLink>, and acknowledge receipt of both our <wtPrivacyLink>Privacy Policy</wtPrivacyLink> and <signPrivacyLink>WeTransfer Sign Privacy Policy</signPrivacyLink>.","verify_and_send_disclaimer_signup":"By creating an account you accept our <wtTermsLink>Terms of Service</wtTermsLink>, including <signTermsLink>WeTransfer Sign Additional Terms of Service</signTermsLink>, and acknowledge receipt of both our <wtPrivacyLink>Privacy Policy</wtPrivacyLink> and <signPrivacyLink>WeTransfer Sign Privacy Policy</signPrivacyLink>.","verify_and_send_signup":"Create and Send","verifying":"Verifying..."},"features":{"description1":"Speed up your workflow with re-usable templates. Whether an NDA, contract, or form, simply create a template once and use it as many times as you need! Reduce manual processes and ensure consistency and legal compliance.","description2":"Send and receive signature requests directly from your mobile device. Whether at your desk, on the train, or halfway around the world, WeTransfer Sign ensures that your documents look polish and remain secure.","description3":"All signatures through WeTransfer Sign are compliant with international regulations like eIDAS, ESIGN, and GDPR. Your documents are encrypted, audit-trailed, and fully protected — meeting the highest global standards so you can operate with confidence, wherever your business takes you.","tag1":"Quick","tag2":"Mobile","tag3":"Certified","title1":"Re-usable document templates","title2":"Request signatures from mobile","title3":"Compliance with global e-signature standards"},"footer":{"additional_terms":"Additional terms","contact_support":"Contact support","cta":"Get started","description":"WeTransfer Sign is the simplest and most elegant way to sign documents online, absolutely free. Built with the same focus on clarity and security that defines WeTransfer, Sign offers a seamless experience for individuals and teams looking to send, sign, and manage documents without hassle or cost.","faq":"FAQ","made_with":"Made with ♥ by WeTransfer","privacy_choices":"Your Privacy Choices","privacy_policy":"Privacy policy","privacy_policy_additional":"Additional Privacy policy","terms":"Terms","title":"Sign up now"},"header":{"from":"from ","login":"Log in","logout":"Log out","prepare_for_signature":"Prepare for signature","sent_by":"sent by ","sign":"Sign","sign_up":"Sign Up","user_menu":"User menu"},"hero":{"cta":"Get started free","subtitle":"With WeTransfer Sign, sending and signing is easy, smooth, and free.","title":"Get your documents signed in seconds, for free."},"landing_content":{"coming_soon":{"bulk_send":{"description":"Get multiple people\'s signatures at once, no back-and-forth needed.","title":"Multiple signers"},"dashboard":{"description":"Prepare a document once and reuse it as many times as you like.","title":"Standard templates"},"multiple_signers":{"description":"Track progress on your documents and see who\'s signed at a glance.","title":"Dashboard view"},"subtitle":"WeTransfer Sign is evolving fast, so you can get signatures done with even less effort.","title":"Coming soon"},"hero":{"description":"With WeTransfer you can already share files with ease, now you can get them signed just as simply. Securing a signature is now more convenient, reliable, and intuitive than ever.","title":"Signing, done the WeTransfer way"},"how_it_works":{"completed":{"description":"You\'ll get your signed document back.","title":"Signed!"},"prepare":{"description":"Decide where the signatures go.","title":"Prepare"},"send":{"description":"Share instantly, track when it\'s signed.","title":"Send"},"subtitle":"Whether you\'re signing yourself or sharing with others, WeTransfer Sign makes it easy to get signatures done.","title":"How it works","upload":{"description":"Upload your document to get started.","title":"Upload"}},"trusted_by":{"title":"Trusted by teams at"},"why_use":{"for_everyone":{"description":"Share with anyone, even if they don\'t have an account.","title":"Made for collaboration"},"secure":{"description":"Your documents stay private, every step of the way.","title":"Privacy by design"},"simplified":{"description":"Go from upload to signature in seconds, hassle-free.","title":"Built for simplicity"},"subtitle":"A simple and accessible way to get documents signed. WeTransfer Sign is easy to use, reliable and available to everyone.","title":"We\'re not fans of admin either","trusted":{"description":"From freelancers to corporates, everyone can sign in style.","title":"Trusted by teams of all sizes"}}},"landing_content_features":{"collaboration":{"description":"Share with anyone, even if they don\'t have an account.","title":"Made for collaboration"},"headline":"Meanwhile, here\'s what makes WeTransfer Sign the perfect choice for preparing and signing documents","secure":{"description":"Your documents stay private every step of the way.","title":"Secure by design"},"simplicity":{"description":"Go from upload to signature in seconds, hassle-free.","title":"Built for simplicity"},"trusted":{"description":"From freelancers to corporates, everyone can sign in style.","title":"Trusted by teams of all sizes"}},"mobile_disclaimer":{"description":"WeTransfer Sign works best on larger screens. To continue, please open this link on your computer.","title":"Get the full experience on desktop"},"multisigner_fakedoor_modal":{"bulk_send":{"alt":"Bulk send","description":"Send a personal copy of the same document to each person. Everyone signs their own version, and you get one signed copy from each.","title":"Separate copies for each signer"},"multisigner":{"alt":"Multisigner","description":"Send one shared document for everyone to sign. You\'ll receive a single file with all signatures collected together.","title":"All signatures on one document"},"title":"How should people sign your document?","working_on_it":{"alt":"Warning"},"working_on_it_description":"Thanks for your feedback! We don\'t support multiple signers yet.","working_on_it_message":"We\'re working on it"},"pdf_tw_popover":{"cta":"Sign for free","description":"With WeTransfer Sign, capturing signatures is easier than ever—whether you\'re signing yourself or sharing with others.","title":"Get your documents signed in seconds."},"perks":{"cta":"Get started","description1":"Make signing easy for everyone, regardless of their tech skills.","description2":"Safely sign and request signatures for your most important documents.","description3":"Get the necessary digital records of who accessed, reviewed, and signed a document.","title":"Discover WeTransfer Sign","title1":"Fast and easy","title2":"Secure and reliable","title3":"Legally-binding"},"sidebar":{"add_field":"Add field","add_field_hint":"Tap here to add your first field","click_to_add_signature":"Click on your document to start adding signature fields. The signers will appear here.","document_title":"Document title","field_date":"Date","field_date_signed":"Date signed","field_signature":"Signature","field_textbox":"Text","fields":"Fields","fields_description":"Click on your document to start adding signature fields. The signers will appear here.","message_description":"We\'ll add it to the email with your document.","message_label":"Message","myself":"Myself","signers":"Signers"},"signature":{"change_font":"Change font","clear":"Clear","click_to_add_field":"Assign a new field","click_to_add_signature":"Assign a new signature field","click_to_add_textbox":"Assign a new textbox field","click_to_place":"👆 Click on the PDF preview to place your signature","click_to_reupload":"Click to re-upload","delete_failed":"Failed to delete signature","delete_in_