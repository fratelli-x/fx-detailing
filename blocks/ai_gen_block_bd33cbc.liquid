{% doc %}
  @prompt
    Add CSS code to center align the heading text in a multicolumn section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-center-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-multicolumn-center__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-multicolumn-center__subheading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
  }

  .ai-multicolumn-center__columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-multicolumn-center__column-{{ ai_gen_id }} {
    text-align: {{ block.settings.column_alignment }};
  }

  .ai-multicolumn-center__column-image-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
  }

  .ai-multicolumn-center__column-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-center__column-title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.column_title_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: 600;
  }

  .ai-multicolumn-center__column-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.column_text_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-multicolumn-center__columns-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-multicolumn-center-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-multicolumn-center__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <div class="ai-multicolumn-center__subheading-{{ ai_gen_id }}">
      {{ block.settings.subheading }}
    </div>
  {% endif %}

  <div class="ai-multicolumn-center__columns-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_key = 'column_' | append: i | append: '_image'
        assign title_key = 'column_' | append: i | append: '_title'
        assign text_key = 'column_' | append: i | append: '_text'
        
        assign column_image = block.settings[image_key]
        assign column_title = block.settings[title_key]
        assign column_text = block.settings[text_key]
      %}

      {% if i <= block.settings.columns_desktop %}
        <div class="ai-multicolumn-center__column-{{ ai_gen_id }}">
          {% if column_image %}
            <div class="ai-multicolumn-center__column-image-{{ ai_gen_id }}">
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
              >
            </div>
          {% endif %}

          {% if column_title != blank %}
            <h3 class="ai-multicolumn-center__column-title-{{ ai_gen_id }}">
              {{ column_title }}
            </h3>
          {% endif %}

          {% if column_text != blank %}
            <div class="ai-multicolumn-center__column-text-{{ ai_gen_id }}">
              {{ column_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

