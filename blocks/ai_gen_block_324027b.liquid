{% doc %}
  @prompt
    Create a visually striking pricing display section for automotive body kits. It should feature a grid or card-based layout with each body kit package shown as a premium card. Each card should include a package name, price, a short description, a list of included items (e.g. front bumper, rear bumper, side skirts), and a call-to-action button. Use a dark/carbon-fibre inspired aesthetic with bold typography, subtle hover effects, and clean dividers. The section should be fully responsive and customisable via theme editor settings (package name, price, description, items list, button label and link, card background colour).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bodykit-pricing-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-bodykit-pricing__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bodykit-pricing__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-bodykit-pricing__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ai-bodykit-pricing__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-bodykit-pricing__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: 40px;
  }

  .ai-bodykit-pricing__card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-bodykit-pricing__card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: {{ block.settings.card_accent_color }};
  }

  .ai-bodykit-pricing__card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .ai-bodykit-pricing__card-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 30px;
    padding-bottom: 25px;
    border-bottom: 1px solid {{ block.settings.card_divider_color }};
  }

  .ai-bodykit-pricing__package-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.package_name_size }}px;
    font-weight: 700;
    color: {{ block.settings.package_name_color }};
    margin: 0 0 15px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .ai-bodykit-pricing__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-bodykit-pricing__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 25px;
    text-align: center;
    line-height: 1.6;
  }

  .ai-bodykit-pricing__items-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
  }

  .ai-bodykit-pricing__item-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_size }}px;
    color: {{ block.settings.item_color }};
    padding: 12px 0;
    border-bottom: 1px solid {{ block.settings.card_divider_color }};
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-bodykit-pricing__item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-bodykit-pricing__item-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: {{ block.settings.card_accent_color }};
  }

  .ai-bodykit-pricing__button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 16px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-bodykit-pricing__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: scale(1.02);
  }

  @media screen and (max-width: 989px) {
    .ai-bodykit-pricing__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-bodykit-pricing__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-bodykit-pricing__package-name-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.package_name_size }}px * 0.9);
    }

    .ai-bodykit-pricing__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bodykit-pricing-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-bodykit-pricing__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .ai-bodykit-pricing__card-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-bodykit-pricing__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-bodykit-pricing__package-name-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.package_name_size }}px * 0.8);
    }

    .ai-bodykit-pricing__price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.8);
    }
  }
{% endstyle %}

<bodykit-pricing-{{ ai_gen_id }} class="ai-bodykit-pricing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bodykit-pricing__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-bodykit-pricing__header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-bodykit-pricing__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-bodykit-pricing__subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-bodykit-pricing__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign package_enabled_key = 'package_' | append: i | append: '_enabled'
          assign package_name_key = 'package_' | append: i | append: '_name'
          assign package_price_key = 'package_' | append: i | append: '_price'
          assign package_description_key = 'package_' | append: i | append: '_description'
          assign package_items_key = 'package_' | append: i | append: '_items'
          assign package_button_label_key = 'package_' | append: i | append: '_button_label'
          assign package_button_link_key = 'package_' | append: i | append: '_button_link'

          assign package_enabled = block.settings[package_enabled_key]
          assign package_name = block.settings[package_name_key]
          assign package_price = block.settings[package_price_key]
          assign package_description = block.settings[package_description_key]
          assign package_items = block.settings[package_items_key]
          assign package_button_label = block.settings[package_button_label_key]
          assign package_button_link = block.settings[package_button_link_key]
        %}

        {% if package_enabled %}
          <div class="ai-bodykit-pricing__card-{{ ai_gen_id }}">
            <div class="ai-bodykit-pricing__card-header-{{ ai_gen_id }}">
              {% if package_name != blank %}
                <h3 class="ai-bodykit-pricing__package-name-{{ ai_gen_id }}">{{ package_name }}</h3>
              {% endif %}
              {% if package_price != blank %}
                <p class="ai-bodykit-pricing__price-{{ ai_gen_id }}">{{ package_price }}</p>
              {% endif %}
            </div>

            {% if package_description != blank %}
              <p class="ai-bodykit-pricing__description-{{ ai_gen_id }}">{{ package_description }}</p>
            {% endif %}

            {% if package_items != blank %}
              {% assign items_array = package_items | split: ',' %}
              <ul class="ai-bodykit-pricing__items-{{ ai_gen_id }}">
                {% for item in items_array %}
                  <li class="ai-bodykit-pricing__item-{{ ai_gen_id }}">
                    <svg class="ai-bodykit-pricing__item-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{{ item | strip }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if package_button_label != blank %}
              <a href="{{ package_button_link }}" class="ai-bodykit-pricing__button-{{ ai_gen_id }}">
                {{ package_button_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</bodykit-pricing-{{ ai_gen_id }}>

<script>
  (function() {
    class BodykitPricing{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-bodykit-pricing__card-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.cards.forEach((card) => {
          card.setAttribute('role', 'article');
        });
      }
    }

    customElements.define('bodykit-pricing-{{ ai_gen_id }}', BodykitPricing{{ ai_gen_id }});
  })();
</script>

