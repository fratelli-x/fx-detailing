{% doc %}
  @prompt
    I want a section that redirects people to the lead form near the bottom of the page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lead-form-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-lead-form-cta__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-lead-form-cta__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .ai-lead-form-cta__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
  }

  .ai-lead-form-cta__subtext-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    max-width: 600px;
  }

  .ai-lead-form-cta__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-lead-form-cta__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-lead-form-cta__button-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-lead-form-cta__button-{{ ai_gen_id }}:hover .ai-lead-form-cta__button-icon-{{ ai_gen_id }} {
    transform: translateY(3px);
  }

  @media screen and (max-width: 749px) {
    .ai-lead-form-cta__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-lead-form-cta__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-lead-form-cta__button-{{ ai_gen_id }} {
      padding: 14px 28px;
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<lead-form-cta-{{ ai_gen_id }} class="ai-lead-form-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-lead-form-cta__container-{{ ai_gen_id }}">
    <div class="ai-lead-form-cta__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-lead-form-cta__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subtext != blank %}
        <div class="ai-lead-form-cta__subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</div>
      {% endif %}

      <button
        class="ai-lead-form-cta__button-{{ ai_gen_id }}"
        data-target-id="{{ block.settings.target_element_id }}"
        aria-label="{{ block.settings.button_text }}"
      >
        {{ block.settings.button_text }}
        {% if block.settings.show_arrow %}
          <svg class="ai-lead-form-cta__button-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        {% endif %}
      </button>
    </div>
  </div>
</lead-form-cta-{{ ai_gen_id }}>

<script>
  (function() {
    class LeadFormCta{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-lead-form-cta__button-{{ ai_gen_id }}');
        if (this.button) {
          this.button.addEventListener('click', this.handleClick.bind(this));
        }
      }

      handleClick(event) {
        event.preventDefault();
        const targetId = this.button.getAttribute('data-target-id');
        
        if (!targetId) {
          console.warn('No target element ID specified');
          return;
        }

        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });

          setTimeout(function() {
            const firstInput = targetElement.querySelector('input, textarea');
            if (firstInput) {
              firstInput.focus();
            }
          }, 600);
        } else {
          console.warn('Target element with ID "' + targetId + '" not found');
        }
      }

      disconnectedCallback() {
        if (this.button) {
          this.button.removeEventListener('click', this.handleClick.bind(this));
        }
      }
    }

    customElements.define('lead-form-cta-{{ ai_gen_id }}', LeadFormCta{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Lead form redirect",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
