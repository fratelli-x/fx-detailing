{% doc %}
  @prompt
    Create a thumbnail gallery section that displays small preview images in a grid with lightbox functionality. Include a background color setting so merchants can customize the section background color. Also include options to customize the number of columns, image spacing, and thumbnail size.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-thumbnail-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-thumbnail-gallery__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-thumbnail-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-thumbnail-gallery__item-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    aspect-ratio: 1;
  }

  .ai-thumbnail-gallery__thumbnail-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-thumbnail-gallery__item-{{ ai_gen_id }}:hover .ai-thumbnail-gallery__thumbnail-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-thumbnail-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-thumbnail-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-thumbnail-gallery__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    padding: 4px 8px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    white-space: nowrap;
  }

  .ai-thumbnail-gallery__lightbox-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.lightbox_overlay_color }};
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-thumbnail-gallery__lightbox-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .ai-thumbnail-gallery__lightbox-content-{{ ai_gen_id }} {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-thumbnail-gallery__lightbox-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: {{ block.settings.lightbox_border_radius }}px;
  }

  .ai-thumbnail-gallery__lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: {{ block.settings.lightbox_button_color }};
    color: {{ block.settings.lightbox_button_text_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    transition: transform 0.2s ease;
  }

  .ai-thumbnail-gallery__lightbox-close-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.lightbox_button_color }};
    color: {{ block.settings.lightbox_button_text_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--prev {
    left: 20px;
  }

  .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--next {
    right: 20px;
  }

  .ai-thumbnail-gallery__lightbox-counter-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.lightbox_button_color }};
    color: {{ block.settings.lightbox_button_text_color }};
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-thumbnail-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--prev {
      left: 10px;
    }

    .ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--next {
      right: 10px;
    }
  }
{% endstyle %}

<thumbnail-gallery-{{ ai_gen_id }} class="ai-thumbnail-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-thumbnail-gallery__container-{{ ai_gen_id }}">
    <div class="ai-thumbnail-gallery__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        
        {% if image != blank %}
          <div class="ai-thumbnail-gallery__item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
              class="ai-thumbnail-gallery__thumbnail-{{ ai_gen_id }}"
            >
          </div>
        {% else %}
          <div class="ai-thumbnail-gallery__item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
            <div class="ai-thumbnail-gallery__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-thumbnail-gallery__empty-state-{{ ai_gen_id }}">
                Add image {{ i }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-thumbnail-gallery__lightbox-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Image gallery lightbox">
    <button class="ai-thumbnail-gallery__lightbox-close-{{ ai_gen_id }}" aria-label="Close lightbox">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <button class="ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }} ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--prev" aria-label="Previous image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="ai-thumbnail-gallery__lightbox-content-{{ ai_gen_id }}">
      <img src="" alt="" class="ai-thumbnail-gallery__lightbox-image-{{ ai_gen_id }}">
    </div>

    <button class="ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }} ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--next" aria-label="Next image">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="ai-thumbnail-gallery__lightbox-counter-{{ ai_gen_id }}">
      <span class="ai-thumbnail-gallery__current-{{ ai_gen_id }}">1</span> / <span class="ai-thumbnail-gallery__total-{{ ai_gen_id }}">1</span>
    </div>
  </div>
</thumbnail-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ThumbnailGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.images = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.thumbnails = this.querySelectorAll('.ai-thumbnail-gallery__item-{{ ai_gen_id }}');
        this.lightbox = this.querySelector('.ai-thumbnail-gallery__lightbox-{{ ai_gen_id }}');
        this.lightboxImage = this.querySelector('.ai-thumbnail-gallery__lightbox-image-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-thumbnail-gallery__lightbox-close-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--prev');
        this.nextButton = this.querySelector('.ai-thumbnail-gallery__lightbox-nav-{{ ai_gen_id }}--next');
        this.currentCounter = this.querySelector('.ai-thumbnail-gallery__current-{{ ai_gen_id }}');
        this.totalCounter = this.querySelector('.ai-thumbnail-gallery__total-{{ ai_gen_id }}');

        this.collectImages();
        this.setupEventListeners();
      }

      collectImages() {
        this.thumbnails.forEach((thumbnail) => {
          const img = thumbnail.querySelector('.ai-thumbnail-gallery__thumbnail-{{ ai_gen_id }}');
          if (img) {
            this.images.push({
              src: img.src.replace(/width=\d+/, 'width=2000'),
              alt: img.alt
            });
          }
        });
        this.totalCounter.textContent = this.images.length;
      }

      setupEventListeners() {
        this.thumbnails.forEach((thumbnail, index) => {
          const img = thumbnail.querySelector('.ai-thumbnail-gallery__thumbnail-{{ ai_gen_id }}');
          if (img) {
            thumbnail.addEventListener('click', () => {
              this.openLightbox(index);
            });
          }
        });

        this.closeButton.addEventListener('click', () => {
          this.closeLightbox();
        });

        this.lightbox.addEventListener('click', (e) => {
          if (e.target === this.lightbox) {
            this.closeLightbox();
          }
        });

        this.prevButton.addEventListener('click', () => {
          this.showPrevious();
        });

        this.nextButton.addEventListener('click', () => {
          this.showNext();
        });

        document.addEventListener('keydown', (e) => {
          if (!this.lightbox.classList.contains('active')) return;
          
          if (e.key === 'Escape') {
            this.closeLightbox();
          } else if (e.key === 'ArrowLeft') {
            this.showPrevious();
          } else if (e.key === 'ArrowRight') {
            this.showNext();
          }
        });
      }

      openLightbox(index) {
        if (this.images.length === 0) return;
        
        this.currentIndex = index;
        this.updateLightboxImage();
        this.lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeLightbox() {
        this.lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }

      showPrevious() {
        this.currentIndex = (this.currentIndex - 1 + this.images.length) % this.images.length;
        this.updateLightboxImage();
      }

      showNext() {
        this.currentIndex = (this.currentIndex + 1) % this.images.length;
        this.updateLightboxImage();
      }

      updateLightboxImage() {
        const image = this.images[this.currentIndex];
        this.lightboxImage.src = image.src;
        this.lightboxImage.alt = image.alt;
        this.currentCounter.textContent = this.currentIndex + 1;
      }
    }

    customElements.define('thumbnail-gallery-{{ ai_gen_id }}', ThumbnailGallery{{ ai_gen_id }});
  })();
</script>

