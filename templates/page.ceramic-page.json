    "collapsible_content_PVGJrU": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_fMQrk9": {
          "type": "collapsible_row",
          "settings": {
            "heading": "DO YOU WORK ON EVERY CAR?",
            "icon": "check_mark",
            "row_content": "<p>FX Detailing works primarily with luxury, classic, performance and exotic vehicles. This offer has been opened to owners who genuinely want to protect and preserve their vehicle properly.</p>",
            "page": ""
          }
        },
        "collapsible_row_bEcXqV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "HOW DO I SECURE MY BOOKING?",
            "icon": "check_mark",
            "row_content": "<p>Simply submit an enquiry through the form below and we will contact you to discuss your vehicle and availability.</p>",
            "page": ""
          }
        },
        "collapsible_row_BgxKrH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "HOW LONG DOES IT TAKE?",
            "icon": "check_mark",
            "row_content": "<p>Job can be completed within 3-5 days and we insist on keeping the vehicle in our indoor facility overnight after the ceramic application for best results.</p>",
            "page": ""
          }
        },
        "collapsible_row_UJiKg3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "HOW LONG DOES CERAMIC COATING LAST?",
            "icon": "check_mark",
            "row_content": "<p>Up to 5 years whether it's garage kept or used for normal daily driving.</p>",
            "page": ""
          }
        },
        "collapsible_row_Wrg66m": {
          "type": "collapsible_row",
          "settings": {
            "heading": "IS PAINT CORRECTION INCLUDED?",
            "icon": "check_mark",
            "row_content": "<p>Paint correction is a separate full vehicle restoration service which can be applied only if needed and in most cases takes about 7 days when combined with this offer.</p>",
            "page": ""
          }
        },
        "collapsible_row_AhxEkR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "HOW IS CERAMIC DIFFERENT FROM WAX?",
            "icon": "check_mark",
            "row_content": "<p>Waxes sit temporarily on the surface and degrade quickly.<br/><br/>Professional ceramic coatings bond directly to the paintwork, delivering significantly greater durability, better gloss and multi-year-long protection.</p>",
            "page": ""
          }
        },
        "collapsible_row_AzzRia": {
          "type": "collapsible_row",
          "settings": {
            "heading": "WILL MY VEHICLE STAY CLEANER?",
            "icon": "check_mark",
            "row_content": "<p>Yes.<br/><br/>Protected surfaces become significantly more hydrophobic, meaning water, grime and contaminants struggle to bond to the paintwork.<br/><br/>Your vehicle becomes easier to clean and stays cleaner for longer.</p>",
            "page": ""
          }
        },
        "collapsible_row_3nAbrV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "DOES CERAMIC COATING STOP SCRATCHES?",
            "icon": "check_mark",
            "row_content": "<p>Ceramic coating helps reduce light scratches, swirl marks and wash-induced marring.<br/><br/>However, it is not a substitute for Paint Protection Film (PPF) and cannot prevent direct impact deep scratches or stone chips.</p>",
            "page": ""
          }
        },
        "collapsible_row_tQpLKB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "WHY IS CERAMIC COATING IMPORTANT?",
            "icon": "check_mark",
            "row_content": "<p>Without proper protection - moisture, road contamination and environmental fallout continuously sit against the paintwork.<br/><br/>Over time, this contributes to:<br/>- dullness<br/>- sun damage<br/>- swirl marks<br/>- corrosion/rust<br/>- premature ageing<br/>- water spots<br/><br/>Ceramic coating helps create a long-term barrier between your vehicle and the environment.</p>",
            "page": ""
          }
        },
        "collapsible_row_bCnRGV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "WHY DO YOU USE GTECHNIQUE",
            "icon": "check_mark",
            "row_content": "<p>Gtechniq is globally recognised for producing arguably the best professional-grade ceramic protection systems trusted by high-end detailers worldwide.<br/><br/>We selected Gtechniq for:<br/>- durability<br/>- gloss enhancement<br/>- hydrophobic performance<br/>- long-term reliability<br/>- best product on the market today</p>",
            "page": ""
          }
        }
      },
