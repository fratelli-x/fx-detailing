    "rich_text_JQiJ6H": {
      "type": "rich-text",
      "blocks": {
        "heading_XtQrHM": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Why London & Surrey's Most Discerning Owners Choose FX Detailing</strong>",
            "heading_size": "h1"
          }
        },
        "text_GJhiVc": {
          "type": "text",
          "settings": {
            "text": "<ul><li><strong>Low-volume on purpose</strong> — Your car is never a slot in a schedule. It receives our full, undivided attention from collection to return.</li></ul><p></p><ul><li><strong>Different options, one standard</strong> — We don't believe in tiered service levels. Every car we accept is treated to the highest standard.</li></ul><p></p><ul><li><strong>Rooted in a decade of dealership experience</strong> — FX Detailing was built inside Fratelli X. Our standards weren't made up - they were demanded by years of working on some of the finest cars in the world.</li></ul><p></p><ul><li><strong>Door-to-door collection and return</strong> — Secure, professional, and entirely stress-free.</li></ul><p></p><ul><li><strong>A flawless track record</strong> — Ten years. Not a single unhappy client.</li></ul>"
          }
        }
      },
