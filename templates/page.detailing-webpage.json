    "image_with_text_VwNccJ": {
      "type": "image-with-text",
      "blocks": {
        "heading_NnUbCz": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Zak Brown (McLaren F1 CEO)</strong>",
            "heading_size": "h1"
          }
        },
        "text_faPkWd": {
          "type": "text",
          "settings": {
            "text": "<p><strong>\"I have been trusting FX Detailing with my vehicles for a number of years now, and I couldn't be happier with the results. Their attention to detail is second to none, and they consistently go above and beyond to ensure the cars look showroom-ready every time. It’s so rare to find someone so dedicated and reliable - I wouldn't use anyone else.\"</strong></p><p><strong>Zak Brown — CEO, McLaren Formula 1 </strong><em>(As shared on social media)</em></p>",
            "text_style": "body"
          }
        }
      },
