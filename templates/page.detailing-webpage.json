      "blocks": {
        "ai_gen_block_7df23dd_iM3jnd": {
          "type": "ai_gen_block_7df23dd",
          "settings": {
            "heading": "<strong>BRING YOUR CAR BACK TO SHOWROOM CONDITION:</strong> <strong>LUXURY CAR DETAILING & PAINT CORRECTION</strong>",
            "heading_font": "oswald_n7",
            "heading_size": 60,
            "heading_line_height": 1.2,
            "heading_letter_spacing": 0.5,
            "heading_text_transform": "none",
            "heading_color": "#000000",
            "heading_spacing": 24,
            "subtext": "<p>We align with clients who expect their vehicles to be returned to and maintained in - true showroom condition.</p><p><strong>You didn’t choose exceptional to settle for average.</strong></p>",
            "subtext_size": 22,
            "subtext_line_height": 1.6,
